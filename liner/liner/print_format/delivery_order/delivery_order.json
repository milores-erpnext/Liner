 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-09-24 13:24:27.462109",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Import-Export Order",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n/* =========================================================\r\n   DELIVERY ORDER - COMPACT A4\r\n   ========================================================= */\r\n\r\n* {\r\n    box-sizing: border-box;\r\n}\r\n\r\nhtml,\r\nbody {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    background: #fff;\r\n    color: #000;\r\n    font-family: \"Times New Roman\", Times, serif;\r\n}\r\n\r\n.page {\r\n    width: 210mm;\r\n    min-height: 297mm;\r\n    margin: 0 auto;\r\n    padding: 8mm 11mm 10mm;\r\n    font-size: 11.5px;\r\n    line-height: 1.15;\r\n}\r\n\r\n/* =========================================================\r\n   HEADER\r\n   ========================================================= */\r\n\r\n.header {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 8px;\r\n    border-bottom: 1px solid #000;\r\n    padding-bottom: 3px;\r\n}\r\n\r\n.company-en {\r\n    font-family: Arial, sans-serif;\r\n    font-size: 9.5px;\r\n    font-weight: bold;\r\n    line-height: 1.15;\r\n}\r\n\r\n.company-ar {\r\n    direction: rtl;\r\n    text-align: right;\r\n    flex: 1;\r\n    font-family: \"Traditional Arabic\", \"Segoe UI\", Arial, sans-serif;\r\n    font-size: 11.5px;\r\n    font-weight: bold;\r\n}\r\n\r\n.header-line {\r\n    border-bottom: 1px dotted #777;\r\n    height: 0;\r\n    margin-top: 2px;\r\n}\r\n\r\n/* =========================================================\r\n   TOP META\r\n   ========================================================= */\r\n\r\n.meta-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-top: 5px;\r\n}\r\n\r\n.meta-table td {\r\n    padding: 1.5px 3px;\r\n    vertical-align: bottom;\r\n    font-size: 11.5px;\r\n}\r\n\r\n.meta-left {\r\n    width: 25%;\r\n}\r\n\r\n.meta-title {\r\n    width: 43%;\r\n    text-align: center;\r\n}\r\n\r\n.meta-label {\r\n    width: 15%;\r\n    text-align: right;\r\n    white-space: nowrap;\r\n}\r\n\r\n.meta-value {\r\n    width: 17%;\r\n    font-weight: bold;\r\n    white-space: nowrap;\r\n}\r\n\r\n/* =========================================================\r\n   TITLES\r\n   ========================================================= */\r\n\r\n.title-ar {\r\n    direction: rtl;\r\n    font-size: 18px;\r\n    font-weight: bold;\r\n    letter-spacing: 4px;\r\n    line-height: 1;\r\n}\r\n\r\n.title-en {\r\n    font-size: 15px;\r\n    font-weight: bold;\r\n    letter-spacing: 2px;\r\n    line-height: 1;\r\n}\r\n\r\n/* =========================================================\r\n   UNDERLINED VALUES\r\n   ========================================================= */\r\n\r\n.value {\r\n    display: inline-block;\r\n    font-weight: bold;\r\n    border-bottom: 1px solid #000;\r\n    padding: 0 3px 1px;\r\n    min-width: 35px;\r\n    white-space: nowrap;\r\n}\r\n\r\n.value-wide {\r\n    display: inline-block;\r\n    font-weight: bold;\r\n    border-bottom: 1px solid #000;\r\n    padding: 0 3px 1px;\r\n    min-width: 100px;\r\n    white-space: nowrap;\r\n}\r\n\r\n.value-full {\r\n    display: block;\r\n    font-weight: bold;\r\n    border-bottom: 1px solid #000;\r\n    padding: 0 3px 1px;\r\n    min-height: 17px;\r\n}\r\n\r\n/* =========================================================\r\n   FIELD TABLE\r\n   ========================================================= */\r\n\r\n.fields {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-top: 3px;\r\n}\r\n\r\n.fields td {\r\n    padding: 2.5px 3px;\r\n    vertical-align: bottom;\r\n    font-size: 11.5px;\r\n}\r\n\r\n.en-lbl {\r\n    white-space: nowrap;\r\n}\r\n\r\n.en-val {\r\n    font-weight: bold;\r\n    white-space: nowrap;\r\n}\r\n\r\n.ar-lbl {\r\n    direction: rtl;\r\n    text-align: right;\r\n    white-space: nowrap;\r\n    width: 1%;\r\n    font-family: \"Traditional Arabic\", \"Segoe UI\", Arial, sans-serif;\r\n    font-size: 11.5px;\r\n    font-weight: normal;\r\n}\r\n\r\n/* =========================================================\r\n   CONSIGNEE\r\n   ========================================================= */\r\n\r\n.consignee-row {\r\n    margin-top: 3px;\r\n    font-size: 11.5px;\r\n    font-weight: bold;\r\n    white-space: nowrap;\r\n}\r\n\r\n.consignee-value {\r\n    display: inline-block;\r\n    min-width: 300px;\r\n    border-bottom: 1px solid #000;\r\n    padding: 0 4px 1px;\r\n    font-weight: bold;\r\n}\r\n\r\n/* =========================================================\r\n   CARGO TABLE\r\n   ========================================================= */\r\n\r\ntable.cargo {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-top: 7px;\r\n    font-size: 10.5px;\r\n    table-layout: fixed;\r\n}\r\n\r\ntable.cargo th,\r\ntable.cargo td {\r\n    border: 1px solid #000;\r\n    padding: 4px 5px;\r\n    vertical-align: top;\r\n}\r\n\r\ntable.cargo th {\r\n    text-align: center;\r\n    font-weight: bold;\r\n    line-height: 1.1;\r\n}\r\n\r\n.th-en {\r\n    font-weight: normal;\r\n    font-size: 10.5px;\r\n}\r\n\r\n.th-ar {\r\n    direction: rtl;\r\n    font-weight: bold;\r\n    font-size: 10.5px;\r\n    font-family: \"Traditional Arabic\", \"Segoe UI\", Arial, sans-serif;\r\n    margin-top: 1px;\r\n}\r\n\r\n.col-marks {\r\n    width: 18%;\r\n}\r\n\r\n.col-pkgs {\r\n    width: 14%;\r\n}\r\n\r\n.col-desc {\r\n    width: 51%;\r\n}\r\n\r\n.col-weight {\r\n    width: 17%;\r\n}\r\n\r\ntable.cargo td {\r\n    font-weight: bold;\r\n    line-height: 1.15;\r\n}\r\n\r\ntd.col-pkgs,\r\ntd.col-weight {\r\n    text-align: left;\r\n}\r\n\r\n/* =========================================================\r\n   REMARKS\r\n   ========================================================= */\r\n\r\n.remarks-title {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: baseline;\r\n    margin-top: 9px;\r\n    font-size: 11.5px;\r\n    font-weight: bold;\r\n}\r\n\r\n.remarks-title .ar {\r\n    direction: rtl;\r\n    font-family: \"Traditional Arabic\", \"Segoe UI\", Arial, sans-serif;\r\n    font-size: 12px;\r\n}\r\n\r\n.remarks-space {\r\n    min-height: 30px;\r\n    border-bottom: 1px solid #000;\r\n    font-size: 10.5px;\r\n    font-weight: bold;\r\n    padding: 3px;\r\n}\r\n\r\n/* =========================================================\r\n   FOOTER (UPDATED FOR PROPER ALIGNMENT)\r\n   ========================================================= */\r\n\r\n.footer-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-top: 20px;\r\n    table-layout: fixed;\r\n}\r\n\r\n.footer-table td {\r\n    vertical-align: top;\r\n    font-size: 9.5px;\r\n}\r\n\r\n.terms-cell {\r\n    width: 48%;\r\n    \r\n    padding: 6px;\r\n    line-height: 1.3;\r\n    font-size: 9px;\r\n    vertical-align: top;\r\n}\r\n\r\n.sign-cell {\r\n    width: 52%;\r\n    padding-left: 20px;\r\n    vertical-align: top;\r\n}\r\n\r\n.sign-cell .for-txt {\r\n    font-size: 11px;\r\n    font-weight: bold;\r\n    margin-bottom: 2px;\r\n}\r\n\r\n.sign-cell .company-name {\r\n    font-weight: bold;\r\n    font-size: 11px;\r\n    line-height: 1.2;\r\n    margin-bottom: 0;\r\n}\r\n\r\n/* New stamp area inside sign-cell */\r\n.stamp-area {\r\n    margin-top: 40px;\r\n    text-align: right;\r\n    font-size: 9.5px;\r\n}\r\n\r\n.stamp-area .stamp-content {\r\n    display: inline-block;\r\n    text-align: left;\r\n}\r\n\r\n/* =========================================================\r\n   PRINT\r\n   ========================================================= */\r\n\r\n@media print {\r\n\r\n    @page {\r\n        size: A4;\r\n        margin: 6mm 8mm;\r\n    }\r\n\r\n    .page {\r\n        width: auto;\r\n        min-height: auto;\r\n        margin: 0;\r\n        padding: 2mm 3mm;\r\n    }\r\n}\r\n</style>\r\n\r\n\r\n<div class=\"page\">\r\n\r\n    <!-- =====================================================\r\n         HEADER\r\n         ===================================================== -->\r\n\r\n    <div class=\"header\">\r\n        {{letter_head}}\r\n    </div>\r\n\r\n    <!-- =====================================================\r\n         JOB REF / TITLE / D.O. NO / DATE\r\n         ===================================================== -->\r\n\r\n    <table class=\"meta-table\">\r\n        <tr>\r\n            <td class=\"meta-left\">\r\n                Job Ref.\r\n                <span class=\"value\">\r\n                    {{ doc.name or '' }}\r\n                </span>\r\n            </td>\r\n            <td class=\"meta-title\">\r\n                <div class=\"title-ar\">\r\n                    \u0625\u0630\u0646 \u0625\u0641\u0640\u0640\u0640\u0631\u0627\u062c\r\n                </div>\r\n            </td>\r\n            <td class=\"meta-label\">\r\n                D. O. No.\r\n            </td>\r\n            <td class=\"meta-value\">\r\n                <span class=\"value\">\r\n                    {{ doc.name or '' }}\r\n                </span>\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td></td>\r\n            <td class=\"meta-title\">\r\n                <div class=\"title-en\">\r\n                    DELIVERY ORDER\r\n                </div>\r\n            </td>\r\n            <td class=\"meta-label\">\r\n                \u0631\u0642\u0645 \u0623\u0645\u0631 \u062a\u0633\u0644\u064a\u0645\r\n            </td>\r\n            <td></td>\r\n        </tr>\r\n        <tr>\r\n            <td></td>\r\n            <td></td>\r\n            <td class=\"meta-label\">\r\n                Date :\r\n            </td>\r\n            <td class=\"meta-value\">\r\n                <span class=\"value\">\r\n                    {{ frappe.utils.format_date(doc.posting_date) if doc.posting_date else '' }}\r\n                </span>\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td></td>\r\n            <td></td>\r\n            <td class=\"meta-label ar-lbl\">\r\n                \u0627\u0644\u062a\u0627\u0631\u064a\u062e\r\n            </td>\r\n            <td></td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- =====================================================\r\n         CARGO / VOYAGE INFORMATION\r\n         ===================================================== -->\r\n\r\n    <table class=\"fields\">\r\n        <tr>\r\n            <td class=\"en-lbl\">\r\n                Cargo ex. M V.\r\n            </td>\r\n            <td class=\"en-val\">\r\n                <span class=\"value-wide\">\r\n                    {{ doc.vessel or '' }}\r\n                </span>\r\n            </td>\r\n            <td></td>\r\n            <td class=\"en-lbl\">\r\n                Voyage.\r\n            </td>\r\n            <td class=\"en-val\">\r\n                <span class=\"value\">\r\n                    {{ doc.voyage_no or '' }}\r\n                </span>\r\n            </td>\r\n            <td class=\"ar-lbl\">\r\n                \u0645\u0646 \u0627\u0644\u0628\u0627\u062e\u0631\u0629&nbsp;&nbsp;&nbsp;&nbsp;\u0627\u0644\u0631\u062d\u0644\u0629\r\n            </td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"en-lbl\" colspan=\"2\">\r\n                ETA/Arrived - Hamad Port / Mesaieed on\r\n            </td>\r\n            <td class=\"en-val\">\r\n                {% if doc.expected_routing %}\r\n                    {% set eta = doc.expected_routing[-1].eta %}\r\n                    <span class=\"value-wide\">\r\n                        {{ frappe.utils.formatdate(\r\n                            frappe.utils.getdate(\r\n                                eta.replace('Arrived On ', '')\r\n                            ),\r\n                            \"dd-MM-yyyy\"\r\n                        ) }}\r\n                    </span>\r\n                {% endif %}\r\n            </td>\r\n            <td colspan=\"2\"></td>\r\n            <td class=\"ar-lbl\">\r\n                \u0648\u0635\u0644\u062a / \u0627\u0644\u0645\u0646\u062a\u0638\u0631 \u0648\u0635\u0648\u0644\u0647\u0627 \u0628\u062a\u0627\u0631\u064a\u062e\r\n            </td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"en-lbl\" colspan=\"2\">\r\n                To, Director of Customs, Hamad port/Mesaieed\r\n            </td>\r\n            <td class=\"en-val\" colspan=\"2\">\r\n                {% if doc.expected_routing %}\r\n                    {% set to = doc.expected_routing[-1].to %}\r\n                    <span class=\"value-wide\">\r\n                        {{ to or '' }}\r\n                    </span>\r\n                {% endif %}\r\n            </td>\r\n            <td></td>\r\n            <td class=\"ar-lbl\">\r\n                \u0627\u0644\u064a \u0645\u062f\u064a\u0631 \u0627\u0644\u062c\u0645\u0627\u0631\u0643 \u2013 \u0645\u064a\u0646\u0627\u0621 \u062d\u0645\u062f\r\n            </td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"en-lbl\" colspan=\"3\">\r\n                Please deliver the Following Cargo to&nbsp; M/s.\r\n            </td>\r\n            <td colspan=\"2\"></td>\r\n            <td class=\"ar-lbl\">\r\n                \u0627\u0644\u0631\u062c\u0627\u0621 \u062a\u0633\u0644\u064a\u0645 \u0627\u0644\u0628\u0636\u0627\u0639\u0629 \u0623\u062f\u0646\u0627\u0647 \u0625\u0644\u0649\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- =====================================================\r\n         CONSIGNEE\r\n         ===================================================== -->\r\n\r\n    {% set consignee =\r\n        doc.table_zvxa\r\n        | selectattr(\"party\", \"equalto\", \"Consignee\")\r\n        | list\r\n        | first\r\n    %}\r\n\r\n    <div class=\"consignee-row\">\r\n        <span class=\"consignee-value\">\r\n            {{ consignee.name1 if consignee else '' }}\r\n        </span>\r\n    </div>\r\n\r\n    <!-- =====================================================\r\n         BEARER / B.L.\r\n         ===================================================== -->\r\n\r\n    <table class=\"fields\">\r\n        <tr>\r\n            <td class=\"en-lbl\" colspan=\"5\">\r\n                or bearer, ex storage area / direct ships side\r\n            </td>\r\n            <td class=\"ar-lbl\">\r\n                \u0623\u0648 \u0625\u0644\u0649 \u062d\u0627\u0645\u0644\u0647\u0627 \u0645\u0646 \u0623\u0645\u0627\u0643\u0646 \u0627\u0644\u062a\u062e\u0632\u064a\u0646 / \u0645\u0646 \u0627\u0644\u0633\u0641\u064a\u0646\u0629 \u0645\u0628\u0627\u0634\u0631\u0629\r\n            </td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"en-lbl\" style=\"padding-top:6px;\">\r\n                B/L Number\r\n            </td>\r\n            <td class=\"en-val\" style=\"padding-top:6px;\">\r\n                <span class=\"value-wide\">\r\n                    {{ doc.bl_no or '' }}\r\n                </span>\r\n            </td>\r\n            <td colspan=\"3\"></td>\r\n            <td></td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- =====================================================\r\n         CARGO TABLE\r\n         ===================================================== -->\r\n\r\n    <table class=\"cargo\">\r\n        <thead>\r\n            <tr>\r\n                <th class=\"col-marks\">\r\n                    <div class=\"th-en\">\r\n                        MARKS AND NOS\r\n                    </div>\r\n                    <div class=\"th-en\">\r\n                        \u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u0634\u062d\u0646\r\n                    </div>\r\n                </th>\r\n                <th class=\"col-pkgs\">\r\n                    <div class=\"th-en\">\r\n                        No. &amp; Kind of Pkgs\r\n                    </div>\r\n                    <div class=\"th-ar\">\r\n                        \u0639\u062f\u062f \u0627\u0644\u0637\u0631\u0648\u062f \u0648\u0646\u0648\u0639\u0647\u0627\r\n                    </div>\r\n                </th>\r\n                <th class=\"col-desc\">\r\n                    <div class=\"th-en\">\r\n                        DESCRIPTION OF GOODS\r\n                    </div>\r\n                    <div class=\"th-ar\">\r\n                        \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0628\u0636\u0627\u0626\u0639\r\n                    </div>\r\n                </th>\r\n                <th class=\"col-weight\">\r\n                    <div class=\"th-en\">\r\n                        Gr. Weight (KGs.)/<br>\r\n                        Measurement (CBm)\r\n                    </div>\r\n                    <div class=\"th-ar\">\r\n                        \u0627\u0644\u0648\u0632\u0646 / \u0627\u0644\u0642\u064a\u0627\u0633\r\n                    </div>\r\n                </th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            <tr>\r\n                <!-- MARKS / CONTAINERS -->\r\n                <td>\r\n                    {% for item in doc.table_tvep %}\r\n                        <div style=\"font-weight:bold;\">\r\n                            {{ item.container_no or '' }}\r\n                            {% if item.c_type %}\r\n                                ({{ item.c_type }})\r\n                            {% endif %}\r\n                        </div>\r\n                    {% endfor %}\r\n                </td>\r\n                <!-- PACKAGES -->\r\n                <td class=\"col-pkgs\">\r\n                    <div>\r\n                        {{ doc.no_of_packs or '' }}\r\n                    </div>\r\n                    <div>\r\n                        {{ doc.package_details or '' }}\r\n                    </div>\r\n                </td>\r\n                <!-- DESCRIPTION -->\r\n                <td>\r\n                    {{ doc.desc_of_goods or '' }}\r\n                </td>\r\n                <!-- WEIGHT -->\r\n                <td class=\"col-weight\">\r\n                    <div>\r\n                        {{ doc.gross_weight_kg or '' }}\r\n                    </div>\r\n                    <div>\r\n                        {{ doc.volume_cbm or '' }}\r\n                    </div>\r\n                </td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- =====================================================\r\n         REMARKS\r\n         ===================================================== -->\r\n\r\n    <div class=\"remarks-title\">\r\n        <div>\r\n            Remarks\r\n        </div>\r\n        <div class=\"ar\">\r\n            \u0645\u0644\u0627\u062d\u0638\u0627\u062a\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"remarks-space\">\r\n        {{ doc.remarks or '' }}\r\n    </div>\r\n\r\n    <!-- =====================================================\r\n         FOOTER (UPDATED)\r\n         ===================================================== -->\r\n\r\n    <table class=\"footer-table\">\r\n        <tr>\r\n            <td class=\"terms-cell\">\r\n                \"This Delivery order is issued subject to the\r\n                safe arrival of the vessel at the port of discharge\r\n                and to the terms, condition, liberties and exceptions\r\n                of the relative bill of lading and any clauses written\r\n                or stamped thereon:\r\n                <br><br>\r\n                (As Agents Only)\r\n            </td>\r\n            <td class=\"sign-cell\">\r\n                <div class=\"for-txt\">\r\n                    For\r\n                </div>\r\n                <div class=\"company-name\">\r\n                    {{doc.company}}\r\n                </div>\r\n\r\n                <!-- Stamp / Footer area aligned to the right -->\r\n                <div class=\"stamp-area\">\r\n                    <div class=\"stamp-content\">\r\n                        {{footer}}\r\n                    </div>\r\n                </div>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n</div>",
