 "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<title>Container Release Order - 7819</title>\r\n<style>\r\n  @page {\r\n    size: A4;\r\n    margin: 14mm 12mm;\r\n  }\r\n\r\n  * { box-sizing: border-box; }\r\n\r\n  body {\r\n    font-family: Arial, Helvetica, sans-serif;\r\n    font-size: 11px;\r\n    color: #111;\r\n    margin: 0;\r\n    padding: 0;\r\n  }\r\n\r\n  .sheet {\r\n    width: 100%;\r\n    max-width: 800px;\r\n    margin: 0 auto;\r\n  }\r\n\r\n  /* ---------- Header ---------- */\r\n  .header {\r\n    display: flex;\r\n    justify-content: flex-end;\r\n    align-items: center;\r\n    border-bottom: 2px solid #444;\r\n    padding-bottom: 6px;\r\n    margin-bottom: 8px;\r\n  }\r\n  .header .logo-fallback {\r\n    text-align: right;\r\n    line-height: 1.2;\r\n  }\r\n  .header .logo-fallback .brand-name {\r\n    font-size: 22px;\r\n    font-weight: bold;\r\n    color: #1f6e3e;\r\n    letter-spacing: 1px;\r\n  }\r\n  .header .logo-fallback .brand-sub {\r\n    font-size: 10px;\r\n    letter-spacing: 2px;\r\n    color: #333;\r\n  }\r\n  .header .logo-fallback .brand-ar {\r\n    font-size: 11px;\r\n    color: #333;\r\n  }\r\n\r\n  /* ---------- generic bordered table ---------- */\r\n  table.doc-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-bottom: 6px;\r\n  }\r\n  table.doc-table td, table.doc-table th {\r\n    border: 1px solid #666;\r\n    padding: 4px 6px;\r\n    vertical-align: top;\r\n  }\r\n\r\n  .title-row td {\r\n    text-align: center;\r\n    font-size: 15px;\r\n    font-weight: bold;\r\n    background: #fff;\r\n    padding: 6px;\r\n  }\r\n\r\n  .label-cell {\r\n    background: #f0f0f0;\r\n    font-weight: bold;\r\n    width: 15%;\r\n    white-space: nowrap;\r\n  }\r\n  .value-cell {\r\n    width: 22%;\r\n  }\r\n\r\n  .section-header td {\r\n    background: #e2e2e2;\r\n    font-weight: bold;\r\n    font-size: 11.5px;\r\n  }\r\n\r\n  .customer-block {\r\n    margin: 6px 0;\r\n    font-size: 11px;\r\n  }\r\n  .customer-block .cust-label {\r\n    display: inline-block;\r\n    margin-bottom: 2px;\r\n  }\r\n  .customer-block .cust-name {\r\n    font-weight: bold;\r\n  }\r\n  .customer-block .cust-address {\r\n    border-top: 1px solid #444;\r\n    display: inline-block;\r\n    padding-top: 2px;\r\n    margin-top: 2px;\r\n  }\r\n\r\n  h3.block-title {\r\n    font-size: 11.5px;\r\n    margin: 8px 0 3px 0;\r\n    font-weight: bold;\r\n  }\r\n\r\n  .commodity-box {\r\n    border: 1px solid #666;\r\n    padding: 5px 6px;\r\n    font-weight: bold;\r\n    margin-bottom: 8px;\r\n  }\r\n\r\n  .containers-title-row {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: baseline;\r\n    margin-bottom: 3px;\r\n  }\r\n  .containers-title-row .cutoff {\r\n    font-weight: bold;\r\n    font-size: 11px;\r\n  }\r\n  .containers-title-row .cutoff .cutoff-value {\r\n    font-weight: bold;\r\n  }\r\n\r\n  table.containers-table th {\r\n    background: #f0f0f0;\r\n    text-align: left;\r\n    font-size: 10.5px;\r\n  }\r\n  table.containers-table td {\r\n    font-size: 10.5px;\r\n  }\r\n  table.containers-table td.num {\r\n    text-align: right;\r\n  }\r\n\r\n  /* ---------- To Shipper ---------- */\r\n  .shipper-title {\r\n    font-weight: bold;\r\n    font-size: 11.5px;\r\n    margin: 8px 0 3px 0;\r\n  }\r\n  table.shipper-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-bottom: 6px;\r\n  }\r\n  table.shipper-table td {\r\n    border: 1px solid #666;\r\n    padding: 3px 6px;\r\n    font-size: 10px;\r\n    vertical-align: top;\r\n  }\r\n  table.shipper-table td.idx {\r\n    width: 3%;\r\n    text-align: center;\r\n    font-weight: bold;\r\n  }\r\n\r\n  .note-block {\r\n    font-weight: bold;\r\n    font-size: 10.5px;\r\n    margin-top: 8px;\r\n    line-height: 1.4;\r\n  }\r\n  .note-block .note-ar {\r\n    direction: rtl;\r\n    text-align: right;\r\n    font-weight: normal;\r\n    display: block;\r\n    margin-top: 4px;\r\n    font-family: \"Traditional Arabic\", \"Arial\", sans-serif;\r\n  }\r\n\r\n  .footer-row {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    font-size: 10px;\r\n    margin-top: 14px;\r\n    padding-top: 4px;\r\n    border-top: 1px solid #999;\r\n  }\r\n\r\n  @media print {\r\n    body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }\r\n  }\r\n</style>\r\n</head>\r\n<body>\r\n<div class=\"sheet\">\r\n\r\n  <!-- ================= HEADER ================= -->\r\n  <div class=\"header\">\r\n    <div class=\"logo-fallback\">\r\n      <div class=\"brand-name\">aero</div>\r\n      <div class=\"brand-sub\">FREIGHT CO. LTD.</div>\r\n      <div class=\"brand-ar\">\u0634\u0631\u0643\u0647 \u0627\u0644\u062c\u0648\u064a\u0647 \u0644\u0644\u0634\u062d\u0646 \u0627\u0644\u0645\u062d\u062f\u0648\u062f\u0647</div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- ================= TITLE + TOP INFO ================= -->\r\n  <table class=\"doc-table\">\r\n    <tr class=\"title-row\"><td colspan=\"4\">Container Release Order</td></tr>\r\n    <tr>\r\n      <td class=\"label-cell\">Issue Date</td>\r\n      <td class=\"value-cell\">{{ frappe.utils.now_datetime().strftime(\"%b %-d, %Y\") }}</td>\r\n      <td class=\"label-cell\">Release Order Date</td>\r\n      <td class=\"value-cell\"></td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"label-cell\">Booking No</td>\r\n      <td class=\"value-cell\">{{doc.line_booking_ref}}</td>\r\n      <td class=\"label-cell\">Carrier</td>\r\n      <td class=\"value-cell\">{{doc.line_name}}</td>\r\n    </tr>\r\n    <tr class=\"section-header\">\r\n      <td colspan=\"2\">Depot/Terminal</td>\r\n      <td colspan=\"2\">Contact Details</td>\r\n    </tr>\r\n    <tr>\r\n      <td colspan=\"2\">{{doc.location}}</td>\r\n      <td colspan=\"2\">\r\n        {{frappe.db.get_value('Party Table',{'parent':doc.name,'party':'Consignee'},'name1')}}<br>\r\n        {{frappe.db.get_value('Party Table',{'parent':doc.name,'party':'Consignee'},'address')}}<br>\r\n        \r\n      </td>\r\n    </tr>\r\n  </table>\r\n\r\n  <!-- ================= CUSTOMER ================= -->\r\n  <div class=\"customer-block\">\r\n    <span class=\"cust-label\">Customer :</span>\r\n    <span class=\"cust-name\">{{frappe.db.get_value('Customer',doc.customer,'customer_name')}}</span><br>\r\n    <span class=\"cust-address\">\r\n      {{frappe.db.get_value('Customer',doc.customer,'primary_address') or ''}}\r\n    </span>\r\n  </div>\r\n\r\n  <!-- ================= SHIPMENT DETAILS ================= -->\r\n  <h3 class=\"block-title\">Shipment Details :</h3>\r\n  <table class=\"doc-table\">\r\n    <tr>\r\n      <td class=\"label-cell\">CRO Validity :</td>\r\n      <td class=\"value-cell\"></td>\r\n      <td class=\"label-cell\">Container Release date :</td>\r\n      <td class=\"value-cell\"></td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"label-cell\">Load Port :</td>\r\n      <td class=\"value-cell\">{{frappe.db.get_value('Routing Table',{'hub':'Port of Loading','parent':doc.name},'hub_name') or ''}}</td>\r\n      <td class=\"label-cell\">Line :</td>\r\n      <td class=\"value-cell\">{{doc.line_name}}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"label-cell\">Discharge Port :</td>\r\n      <td class=\"value-cell\">{{frappe.db.get_value('Routing Table',{'hub':'Port of Discharge','parent':doc.name},'hub_name') or ''}}</td>\r\n      <td class=\"label-cell\">Vessel :</td>\r\n      <td class=\"value-cell\">{{doc.vessel}}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"label-cell\">Final Destination :</td>\r\n      <td class=\"value-cell\">{{frappe.db.get_value('Routing Table',{'hub':'Place of Delivery','parent':doc.name},'hub_name') or ''}}</td>\r\n      <td class=\"label-cell\">Voyage :</td>\r\n      <td class=\"value-cell\">{{doc.voyage_no or ''}}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"label-cell\">ETD</td>\r\n      <td class=\"value-cell\">{{doc.expected_routing[-1].etd}}</td>\r\n      <td class=\"label-cell\">ETA</td>\r\n      <td class=\"value-cell\">{{doc.expected_routing[-1].eta}}</td>\r\n    </tr>\r\n  </table>\r\n\r\n  <!-- ================= COMMODITY ================= -->\r\n  <h3 class=\"block-title\">Commodity :</h3>\r\n  <div class=\"commodity-box\">EMPTY CONTAINERS BACK LOADING</div>\r\n\r\n  <!-- ================= CONTAINER DETAILS ================= -->\r\n  <div class=\"containers-title-row\">\r\n    <h3 class=\"block-title\" style=\"margin:0;\">Container Details :</h3>\r\n    <div class=\"cutoff\">\r\n      Cut-Off Date : <span class=\"cutoff-value\">14-09-2026</span>\r\n      &nbsp;&nbsp;Time :<span class=\"cutoff-value\">20:00 Hours</span>\r\n    </div>\r\n  </div>\r\n  <table class=\"doc-table containers-table\">\r\n    <tr>\r\n      <th>SrNo</th>\r\n      <th>Container No</th>\r\n      <th>Type</th>\r\n      <th>ISO Code</th>\r\n      <th>Seal No</th>\r\n      <th>Gross Weight (Kg.)</th>\r\n      <th>Dimensions</th>\r\n    </tr>\r\n    {% for row in doc.table_tvep %}\r\n    <tr>\r\n      <td>{{row.idx}}</td>\r\n      <td>{{row.container_no}}</td>\r\n      <td>{{row.c_type}}</td>\r\n      <td></td>\r\n      <td>{{row.seal_no}}</td>\r\n      <td>{{row.tare_wt}}</td>\r\n      <td></td>\r\n    </tr>\r\n    {% endfor %}\r\n  </table>\r\n\r\n  <!-- ================= TO SHIPPER ================= -->\r\n  <div class=\"shipper-title\">To Shipper</div>\r\n  <table class=\"shipper-table\">\r\n    <tr>\r\n      <td class=\"idx\">1</td>\r\n      <td>This container release letter is VALID ONLY FOR 2 DAYS (48 HOURS) from the issue date of the letter and thereafter it will be considered as cancelled without any intimation.</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"idx\">2</td>\r\n      <td>Please check the empty containers prior release and accept only sound units. In case containers are returned unused on accounts of damage all related charges will be on shipper's account.</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"idx\">3</td>\r\n      <td>Gross weight of the cargo not to exceed the weight limit on the container's CSC plate. Any charges related to exceeding weight will be hence on shipper's account.</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"idx\">4</td>\r\n      <td>Pls make sure weight declared during container release should be same as manifest filed at the port to avoid any loading problems at the Port.</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"idx\">5</td>\r\n      <td>Please use only line's bottle seal for each container. We will charge QR 15 for every seal issued.</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"idx\">6</td>\r\n      <td>B/L details with any special instructions must be submitted to our office 24 hours prior to vessel cut off. Please ensure that a copy of the packing list and invoice are placed inside the containers prior to the sealing of any bound shipment.</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"idx\">7</td>\r\n      <td>Stuffing of IMCO cargo with prior approval only. Containers to be affixed with IMCO labels on all four sides of the unit prior returning to port and similarly any old labels should be duly removed prior being sent to the port.</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"idx\">8</td>\r\n      <td>ALL BOOKINGS ARE SUBJECT TO TERMS AND CONDITIONS OF CARRIERS BILL OF LADING.</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"idx\">9</td>\r\n      <td>Ensure collection of OB/L within 7 working days from the invoice issue date, failing which a late B/L collection fee of QR 100 will be charged per week.</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"idx\">10</td>\r\n      <td>B/L draft should be confirm before sailing the vessel.</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"idx\">11</td>\r\n      <td>After sailing the vessel B/L amendment charges will be applicable, charges are subject to destination port/customs amended tariff.</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"idx\">12</td>\r\n      <td>From 1st of January, 2016 all the Gate-in export full containers will need a verified container weight (Weight receipt) as a condition of export acceptance in Doha Port.</td>\r\n    </tr>\r\n  </table>\r\n\r\n  <!-- ================= NOTE ================= -->\r\n  <div class=\"note-block\">\r\n    Note :- This document can be re-produce in Arabic language, upon request. Further should you wish to set Arabic as your preferred language for future standard notices, please contact our customer service.\r\n    <span class=\"note-ar\">\u064a\u0645\u0643\u0646 \u062a\u0642\u062f\u064a\u0645 \u0647\u0630\u0627 \u0627\u0644\u0645\u0633\u062a\u0646\u062f \u0628\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629\u060c \u0648\u0641\u064a \u0627\u0644\u0645\u0633\u062a\u0642\u0628\u0644 \u0646\u0631\u062c\u0648 \u062a\u062d\u062f\u064a\u062f \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0643\u0644\u063a\u0629 \u0627\u0633\u0627\u0633\u064a\u0629 \u0644\u062c\u0645\u064a\u0639 \u0627\u0644\u0627\u062e\u0637\u0627\u0631\u0627\u062a \u0627\u0644\u0642\u0627\u062f\u0645\u0629\u060c \u0644\u0644\u062a\u0648\u0627\u0635\u0644 \u0647\u0627\u062a\u0641 \u062e\u062f\u0645\u0629 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0631\u0642\u0645</span>\r\n  </div>\r\n\r\n  <!-- ================= FOOTER ================= -->\r\n  <div class=\"footer-row\">\r\n    <div>Page 1 of 1</div>\r\n    <div>Generated By {{doc.owner}}&nbsp;&nbsp;{{doc.creation}}</div>\r\n  </div>\r\n\r\n</div>\r\n</body>\r\n</html>",
