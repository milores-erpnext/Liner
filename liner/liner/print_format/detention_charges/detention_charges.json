 "doc_type": "Import-Export Order",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "\r\n<style>\r\n    .detention-wrapper {\r\n        font-family: Arial, sans-serif;\r\n        font-size: 11px;\r\n        color: #222;\r\n    }\r\n\r\n    .detention-title {\r\n        text-align: center;\r\n        font-size: 18px;\r\n        font-weight: bold;\r\n        margin-bottom: 15px;\r\n        border-bottom: 2px solid #222;\r\n        padding-bottom: 8px;\r\n    }\r\n\r\n    .info-table,\r\n    .detention-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .info-table td {\r\n        padding: 5px 7px;\r\n        border: 1px solid #ccc;\r\n    }\r\n\r\n    .info-label {\r\n        font-weight: bold;\r\n        background: #f3f3f3;\r\n        width: 15%;\r\n    }\r\n\r\n    .detention-table {\r\n        margin-top: 15px;\r\n    }\r\n\r\n    .detention-table th,\r\n    .detention-table td {\r\n        border: 1px solid #999;\r\n        padding: 6px;\r\n        text-align: center;\r\n    }\r\n\r\n    .detention-table th {\r\n        background: #eeeeee;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .text-left {\r\n        text-align: left !important;\r\n    }\r\n\r\n    .calculation {\r\n        white-space: nowrap;\r\n        font-size: 10px;\r\n    }\r\n\r\n    .total-row {\r\n        font-weight: bold;\r\n        background: #f3f3f3;\r\n    }\r\n</style>\r\n\r\n<div class=\"detention-wrapper\">\r\n\r\n    <div class=\"detention-title\">\r\n        DETENTION CALCULATION\r\n    </div>\r\n\r\n    <!-- Basic Information -->\r\n    <table class=\"info-table\">\r\n        <tr>\r\n            <td class=\"info-label\">Document No.</td>\r\n            <td>{{ doc.name }}</td>\r\n\r\n            <td class=\"info-label\">BL No.</td>\r\n            <td>{{ doc.bl_no or \"\" }}</td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"info-label\">Vessel</td>\r\n            <td>{{ doc.vessel or \"\" }}</td>\r\n\r\n            <td class=\"info-label\">Voyage No.</td>\r\n            <td>{{ doc.voyage_no or \"\" }}</td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- Detention Details -->\r\n    <table class=\"detention-table\">\r\n        <thead>\r\n            <tr>\r\n                <th>Sr.</th>\r\n                <th>Container No.</th>\r\n                <th>Type</th>\r\n                <th>In Date</th>\r\n                <th>Return Date</th>\r\n                <th>Total Days</th>\r\n                <th>Free Days</th>\r\n                <th>Chargeable Days</th>\r\n                <th>Rate / Day</th>\r\n                <th>Gross Detention</th>\r\n                <th>Waiver</th>\r\n                <th>Net</th>\r\n                <th>Calculation</th>\r\n            </tr>\r\n        </thead>\r\n\r\n        <tbody>\r\n\r\n            {% set total_gross = namespace(value=0) %}\r\n            {% set total_waiver = namespace(value=0) %}\r\n            {% set total_net = namespace(value=0) %}\r\n\r\n            {% for row in doc.table_tvep %}\r\n\r\n                <!-- Total detention days -->\r\n                {% set total_days = frappe.utils.date_diff(\r\n                    row.return_date,\r\n                    row.in_date\r\n                ) %}\r\n\r\n                {% if total_days <= 0 %}\r\n                    {% set total_days = 1 %}\r\n                {% endif %}\r\n\r\n                <!-- Free days -->\r\n                {% set free_days = (row.free_days or 0) | int %}\r\n\r\n                <!-- Chargeable days -->\r\n                {% set chargeable_days = total_days - free_days %}\r\n\r\n                {% if chargeable_days < 0 %}\r\n                    {% set chargeable_days = 0 %}\r\n                {% endif %}\r\n\r\n                <!-- Net detention stored in dt_charges -->\r\n                {% set net = (row.dt_charges or 0) | float %}\r\n\r\n                <!-- Derive rate -->\r\n                {% if chargeable_days > 0 %}\r\n                    {% set rate = net / chargeable_days %}\r\n                {% else %}\r\n                    {% set rate = 0 %}\r\n                {% endif %}\r\n\r\n                <!-- Gross Detention -->\r\n                {% set gross = total_days * rate %}\r\n\r\n                <!-- Waiver = Free Days \u00d7 Rate -->\r\n                {% set waiver = free_days * rate %}\r\n\r\n                <!-- Net = Gross - Waiver -->\r\n                {% set net_calculated = gross - waiver %}\r\n\r\n                {% set total_gross.value = total_gross.value + gross %}\r\n                {% set total_waiver.value = total_waiver.value + waiver %}\r\n                {% set total_net.value = total_net.value + net_calculated %}\r\n\r\n                <tr>\r\n\r\n                    <td>\r\n                        {{ loop.index }}\r\n                    </td>\r\n\r\n                    <td class=\"text-left\">\r\n                        {{ row.container_no }}\r\n                    </td>\r\n\r\n                    <td>\r\n                        {{ row.c_type }}\r\n                    </td>\r\n\r\n                    <td>\r\n                        {{ frappe.utils.formatdate(row.in_date)\r\n                           if row.in_date else \"\" }}\r\n                    </td>\r\n\r\n                    <td>\r\n                        {{ frappe.utils.formatdate(row.return_date)\r\n                           if row.return_date else \"\" }}\r\n                    </td>\r\n\r\n                    <td>\r\n                        {{ total_days }}\r\n                    </td>\r\n\r\n                    <td>\r\n                        {{ free_days }}\r\n                    </td>\r\n\r\n                    <td>\r\n                        {{ chargeable_days }}\r\n                    </td>\r\n\r\n                    <td>\r\n                        {{ \"%.2f\"|format(rate) }}\r\n                    </td>\r\n\r\n                    <td>\r\n                        {{ \"%.2f\"|format(gross) }}\r\n                    </td>\r\n\r\n                    <td>\r\n                        {{ \"%.2f\"|format(waiver) }}\r\n                    </td>\r\n\r\n                    <td>\r\n                        {{ \"%.2f\"|format(net_calculated) }}\r\n                    </td>\r\n\r\n                    <td class=\"calculation\">\r\n                        {{ total_days }} \u00d7 {{ \"%.2f\"|format(rate) }}\r\n                        =\r\n                        {{ \"%.2f\"|format(gross) }}\r\n                        -\r\n                        {{ free_days }} \u00d7 {{ \"%.2f\"|format(rate) }}\r\n                        =\r\n                        {{ \"%.2f\"|format(net_calculated) }}\r\n                    </td>\r\n\r\n                </tr>\r\n\r\n            {% endfor %}\r\n\r\n            <!-- Total -->\r\n            <tr class=\"total-row\">\r\n\r\n                <td colspan=\"9\" class=\"text-left\">\r\n                    TOTAL\r\n                </td>\r\n\r\n                <td>\r\n                    {{ \"%.2f\"|format(total_gross.value) }}\r\n                </td>\r\n\r\n                <td>\r\n                    {{ \"%.2f\"|format(total_waiver.value) }}\r\n                </td>\r\n\r\n                <td>\r\n                    {{ \"%.2f\"|format(total_net.value) }}\r\n                </td>\r\n\r\n                <td>\r\n                    {{ \"%.2f\"|format(total_gross.value) }}\r\n                    -\r\n                    {{ \"%.2f\"|format(total_waiver.value) }}\r\n                    =\r\n                    {{ \"%.2f\"|format(total_net.value) }}\r\n                </td>\r\n\r\n            </tr>\r\n\r\n        </tbody>\r\n    </table>\r\n\r\n</div>\r\n",
 "idx": 0,
