 "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <title>Cargo Manifest (Import)</title>\r\n    <style>\r\n        @page {\r\n            size: A4 landscape;\r\n            margin: 6mm;\r\n        }\r\n\r\n        body {\r\n            font-family: Arial, Helvetica, sans-serif;\r\n            font-size: 8.5px;\r\n            color: #000;\r\n            margin: 0;\r\n            padding: 0;\r\n            background-color: #fff;\r\n        }\r\n\r\n        .page {\r\n            width: 100%;\r\n            page-break-after: always;\r\n            box-sizing: border-box;\r\n            position: relative;\r\n            min-height: 195mm;\r\n            padding-bottom: 25px; /* Space for page footer */\r\n        }\r\n\r\n        .page:last-child {\r\n            page-break-after: avoid;\r\n        }\r\n\r\n        /* Company Header */\r\n        .company-header {\r\n            text-align: center;\r\n            font-size: 8.5px;\r\n            line-height: 1.25;\r\n            margin-bottom: 2px;\r\n        }\r\n\r\n        .company-title {\r\n            font-size: 11px;\r\n            font-weight: bold;\r\n            letter-spacing: 0.5px;\r\n        }\r\n\r\n        .document-title {\r\n            text-align: center;\r\n            font-size: 11px;\r\n            font-weight: bold;\r\n            text-decoration: underline;\r\n            margin: 4px 0 6px 0;\r\n        }\r\n\r\n        /* Metadata Header Table */\r\n        table.meta-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            margin-bottom: 4px;\r\n        }\r\n\r\n        table.meta-table td {\r\n            font-size: 8.5px;\r\n            padding: 1px 2px;\r\n            vertical-align: top;\r\n        }\r\n\r\n        /* Manifest Item Table */\r\n        table.manifest-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            margin-bottom: 12px;\r\n            page-break-inside: avoid;\r\n        }\r\n\r\n        table.manifest-table th, \r\n        table.manifest-table td {\r\n            border: 1px solid #000;\r\n            padding: 3px 4px;\r\n            font-size: 8px;\r\n            vertical-align: top;\r\n            word-wrap: break-word;\r\n        }\r\n\r\n        table.manifest-table th {\r\n            background-color: #fff;\r\n            font-weight: bold;\r\n            text-align: center;\r\n            text-transform: uppercase;\r\n            font-size: 7.5px;\r\n        }\r\n\r\n        .text-center {\r\n            text-align: center;\r\n        }\r\n\r\n        .text-right {\r\n            text-align: right;\r\n        }\r\n\r\n        .bold {\r\n            font-weight: bold;\r\n        }\r\n\r\n        /* Total Summary Rows inside table */\r\n        .summary-row td {\r\n            font-weight: bold;\r\n            border-top: 1px solid #000;\r\n            border-bottom: 1px solid #000;\r\n        }\r\n\r\n        /* Page Footer */\r\n        .page-footer {\r\n            position: absolute;\r\n            bottom: 0;\r\n            left: 0;\r\n            right: 0;\r\n            display: flex;\r\n            justify-content: space-between;\r\n            font-size: 8px;\r\n            border-top: 1px solid #ccc;\r\n            padding-top: 3px;\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n    <!-- PAGE 1 -->\r\n    <div class=\"page\">\r\n        <!-- Header -->\r\n        <div class=\"company-header\">\r\n            <div class=\"company-title\">INTERNATIONAL COMMERCIAL AND SHIPPING SERVICES COMPANY W.L.L</div>\r\n            BUILDING 131, STREET 230, ZONE 42. AL HILAL WEST, DOHA, QATAR. POST BOX 8681. CR # 23924.<br>\r\n            Tel : 974-44-11683, Fax : 974-43-52690, E-MAIL : icss@qatar.net.qa\r\n        </div>\r\n\r\n        <div class=\"document-title\">CARGO MANIFEST</div>\r\n\r\n        <table class=\"meta-table\">\r\n            <tr>\r\n                <td width=\"33%\"><b>Manifest No.</b> {{ doc.name or \"\" }}</td>\r\n                <td width=\"33%\"><b>Vessel Name</b> {{ doc.vessel or \"\" }}</td>\r\n                <td width=\"34%\"><b>Port of Loading</b>  {{frappe.db.get_value('Routing Table',{'hub':'Port of Loading','parent':doc.name},'hub_name') or ''}}</td>\r\n            </tr>\r\n            <tr>\r\n                <td><b>Manifest Date</b> {{ doc.creation or \"\" }}</td>\r\n                <td><b>Voyage No</b> {{ doc.voyage_no or \"\" }}</td>\r\n                <td><b>Port of Dicharge</b>  {{frappe.db.get_value('Routing Table',{'hub':'Port of Discharge','parent':doc.name},'hub_name') or ''}}</td>\r\n            </tr>\r\n            <tr>\r\n                <td><b>BL No</b> {{ doc.bl_no or \"\" }}</td>\r\n                <td colspan=\"2\"><b>Line</b> {{ doc.line_name or \"\" }}</td>\r\n            </tr>\r\n        </table>\r\n\r\n        <table class=\"manifest-table\">\r\n            <thead>\r\n                <tr>\r\n                    <th width=\"20%\">SHIPPER<br>CONSIGNEE<br>NOTIFY PARTY</th>\r\n                    <th width=\"12%\">MARKS & NUMBERS</th>\r\n                    <th width=\"12%\">Container No</th>\r\n                    <th width=\"8%\">No. OF PACKAGES</th>\r\n                    <th width=\"22%\">DESCRIPTION OF GOODS</th>\r\n                    <th width=\"11%\">REMARKS</th>\r\n                    <th width=\"5%\">GROSS Wt. (Kg.)</th>\r\n                    <th width=\"5%\">VOLUME (CBM)</th>\r\n                    <th width=\"5%\">FREIGHT STATUS</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                <tr>\r\n                    <td>\r\n                        <b>S--</b> {{frappe.db.get_value(\"Party Table\",{\"party\":\"Shipper\",\"parent\":doc.name},\"name1\")}}<br><br>\r\n                        <b>C--</b>{{frappe.db.get_value(\"Party Table\",{\"party\":\"Consignee\",\"parent\":doc.name},\"name1\")}}<br><br>\r\n                        <b>N--</b> {{frappe.db.get_value(\"Party Table\",{\"party\":\"Notify1\",\"parent\":doc.name},\"name1\")}}\r\n                    </td>\r\n                    <td>\r\n                        {{doc.marks_and_nos or ''}}\r\n                    </td>\r\n                    <td>\r\n                        {% for item in doc.table_tvep %}\r\n                            <div style=\"font-weight:bold;\">\r\n                                {{ item.container_no or '' }}\r\n                                {% if item.c_type %}\r\n                                    ({{ item.c_type }})\r\n                                {% endif %}\r\n                            </div>\r\n                        {% endfor %}\r\n                    </td>\r\n                    <td class=\"text-center\">\r\n                        {{doc.no_of_packs}} CARTONS\r\n                    </td>\r\n                    <td>\r\n                        {{doc.desc_of_goods or ''}}\r\n                    </td>\r\n                    <td>\r\n                        {{doc.remarks or ''}}\r\n                    </td>\r\n                    <td class=\"text-right\">{{doc.gross_weight_kg or ''}}</td>\r\n                    <td class=\"text-right\">{{doc.volume_cbm or ''}}</td>\r\n                    <td class=\"text-center\">{{doc.freight_type or ''}}</td>\r\n                </tr>\r\n                <tr class=\"summary-row\">\r\n                    <td colspan=\"3\"></td>\r\n                    <td class=\"text-center\">{{doc.no_of_packs}}</td>\r\n                    <td colspan=\"2\"></td>\r\n                    <td class=\"text-right\">{{doc.gross_weight_kg or ''}}</td>\r\n                    <td class=\"text-right\">{{doc.volume_cbm or ''}}</td>\r\n                    <td></td>\r\n                </tr>\r\n            </tbody>\r\n        </table>\r\n        \r\n        <!-- Page Footer -->\r\n        <div class=\"page-footer\">\r\n            <span>Generated By {{ doc.owner }}</span>\r\n        </div>\r\n    </div>\r\n\r\n</body>\r\n</html>",
