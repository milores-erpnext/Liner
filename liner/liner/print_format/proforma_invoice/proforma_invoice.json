 "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<title>Invoice 00029730</title>\r\n<style>\r\n  /* ERPNext / wkhtmltopdf style approach */\r\n  @page { \r\n    size: A4; \r\n    margin: 5mm 1mm 15mm 1mm; /* Top, Right, Bottom, Left */\r\n  }\r\n  \r\n  html, body { \r\n    margin: 0 !important; \r\n    padding: 0 !important; \r\n    width: 100% !important;\r\n    background: #e6e6e6; \r\n    font-family: \"Courier New\", Courier, monospace; \r\n    font-size: 10.5pt; \r\n    color: #222;\r\n    line-height: 1.3;\r\n  }\r\n\r\n  /* Print specific adjustments to match ERPNext */\r\n  @media print {\r\n    body { background: #fff; padding: 0; }\r\n    .invoice-sheet { \r\n      width: 100% !important; \r\n      padding: 0 20px !important; /* Side margins for print */\r\n      box-shadow: none; \r\n    }\r\n  }\r\n\r\n  /* Flex wrapper to keep footer at bottom */\r\n  .invoice-sheet {\r\n    display: flex;\r\n    flex-direction: column;\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  /* =========================================================\r\n     HEADER\r\n     ========================================================= */\r\n  .header { \r\n    display: flex; \r\n    justify-content: space-between; \r\n    align-items: flex-start; \r\n    margin-bottom: 15px; \r\n    width: 100%;\r\n  }\r\n  .logo-section { display: flex; align-items: flex-start; }\r\n  .logo-svg { width: 80px; height: auto; }\r\n  .logo-text { \r\n    font-family: \"Arial Black\", sans-serif; \r\n    font-weight: 900; \r\n    font-size: 46px; \r\n    line-height: 0.85; \r\n    margin-left: 5px; \r\n    letter-spacing: -2px; \r\n    color: #111;\r\n  }\r\n  .arabic-name { \r\n    font-family: Tahoma, Arial, sans-serif; \r\n    font-weight: bold; \r\n    font-size: 16px; \r\n    margin-top: 5px; \r\n  }\r\n  .header-right { \r\n    text-align: right; \r\n    font-family: Arial, sans-serif; \r\n    font-weight: bold; \r\n    font-size: 8px; \r\n    text-transform: uppercase; \r\n    line-height: 1.2;\r\n    margin-top: 5px;\r\n  }\r\n\r\n  /* =========================================================\r\n     INVOICE BOX\r\n     ========================================================= */\r\n  .inv-box-wrapper { margin: 15px 0 20px 0; padding-left: 60px; }\r\n  .inv-box {\r\n    width: 240px;\r\n    border: 1px solid #222;\r\n    text-align: center;\r\n    font-family: \"Times New Roman\", serif;\r\n    font-weight: bold;\r\n  }\r\n  .inv-box .t { font-size: 18px; padding: 4px 0; }\r\n  .inv-box .n { font-size: 12px; padding-bottom: 6px; }\r\n\r\n  /* =========================================================\r\n     PARTIES\r\n     ========================================================= */\r\n  .parties { display: flex; justify-content: space-between; margin-bottom: 15px; width: 100%; }\r\n  .party { width: 48%; line-height: 1.5; }\r\n  .party .title { font-weight: bold; margin-bottom: 4px; }\r\n  \r\n  /* =========================================================\r\n     SHIPMENT TABLE\r\n     ========================================================= */\r\n  .sec-title { font-weight: bold; margin-bottom: 5px; }\r\n  .ship-table { width: 100%; border-collapse: collapse; margin-bottom: 5px; }\r\n  .ship-table td { padding: 2px 0; vertical-align: top; line-height: 1.4; }\r\n  .ship-table .lbl { width: 18%; }\r\n  .ship-table .val { width: 32%; }\r\n  .trn { font-weight: bold; font-size: 9pt; margin-bottom: 10px; padding-left: 2px;}\r\n\r\n  /* =========================================================\r\n     CHARGES TABLE\r\n     ========================================================= */\r\n  .charges-table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }\r\n  .charges-table th { border-top: 1px solid #000; border-bottom: 1px solid #000; padding: 6px 0; text-align: left; font-weight: bold;  color: #000;}\r\n  .charges-table td { padding: 5px 0; }\r\n  .charges-table .right { text-align: right; }\r\n\r\n  /* =========================================================\r\n     CONTAINER ROW\r\n     ========================================================= */\r\n  .container-row { \r\n    border-top: 1px solid #ccc; \r\n    border-bottom: 1px solid #ccc; \r\n    padding: 6px 0; \r\n    margin-bottom: 15px; \r\n  }\r\n\r\n  /* =========================================================\r\n     BANK DETAILS\r\n     ========================================================= */\r\n  .bank-section { \r\n    margin-left: 25%; \r\n    font-family: Arial, sans-serif; \r\n    font-size: 8px; \r\n    line-height: 1.4;\r\n    margin-bottom: 15px;\r\n    width: 75%;\r\n  }\r\n  .bank-header { border-bottom: 1px solid #333; padding-bottom: 4px; margin-bottom: 4px; color: #666; }\r\n  .bank-row { display: flex; margin-bottom: 2px;}\r\n  .bank-row .val { margin-left: 10px; }\r\n\r\n  /* =========================================================\r\n     FOOTER - Pushed to bottom via margin-top: auto\r\n     ========================================================= */\r\n  .footer-block {\r\n    margin-top: auto;\r\n    padding-top: 10px;\r\n    width: 100%;\r\n  }\r\n  \r\n  .total-row { \r\n    border-top: 1px solid #222; \r\n    border-bottom: 1px solid #222; \r\n    padding: 6px 0; \r\n    display: flex; \r\n    justify-content: space-between; \r\n    font-weight: bold; \r\n    margin-bottom: 5px;\r\n  }\r\n  .exch-rate { padding: 5px 0; border-bottom: 1px solid #ddd; margin-bottom: 10px; }\r\n  \r\n  .terms { font-size: 8.5pt; line-height: 1.4; margin-bottom: 8px; }\r\n  .for-company { font-style: italic; font-weight: bold; margin-bottom: 8px; }\r\n  .note { font-family: Arial, sans-serif; font-size: 8.5pt; color: #0b6fc2; line-height: 1.3; margin-bottom: 15px;}\r\n  \r\n  .company-info { \r\n    border-top: 1px dotted #888; \r\n    padding-top: 8px; \r\n    text-align: center; \r\n    font-family: Arial, sans-serif; \r\n    font-size: 8px; \r\n    line-height: 1.5;\r\n  }\r\n  .generated { text-align: right; font-family: \"Times New Roman\", serif; font-size: 8px; margin-top: 5px; }\r\n\r\n</style>\r\n</head>\r\n<body>\r\n\r\n<div class=\"invoice-sheet\">\r\n\r\n  <!-- HEADER -->\r\n  <div class=\"header\">\r\n    {{letter_head}}\r\n  </div>\r\n\r\n  <!-- INVOICE BOX -->\r\n  <div class=\"inv-box-wrapper\">\r\n    <div class=\"inv-box\">\r\n      <div class=\"t\">INVOICE</div>\r\n      <div class=\"n\">{{doc.name}}&nbsp;&nbsp;{{doc.transaction_date}}</div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- PARTIES -->\r\n  <div class=\"parties\">\r\n    <div class=\"party\">\r\n      <div class=\"title\">Messers..</div>\r\n      <div>{{doc.customer_name}} | CR No:4512</div>\r\n      <div>{{doc.address_display}}</div>\r\n    </div>\r\n    <div class=\"party\">\r\n      <div class=\"title\">Shipper....</div>\r\n      <div>{{doc.shipping_address_name or ''}}</div>\r\n      <div>{{doc.shipping_address or ''}}</div>\r\n    </div>\r\n  </div>\r\n    {% set ref_doc = frappe.get_doc(\"Import-Export Order\",doc.custom_importexport_order) %}\r\n  <!-- SHIPMENT DETAILS -->\r\n  <div class=\"sec-title\">Shipment Details</div>\r\n  <table class=\"ship-table\">\r\n    <tr>\r\n      <td class=\"lbl\">Our Ref..</td><td class=\"val\">{{ref_doc.name or ''}}</td>\r\n      <td class=\"lbl\">Clients Ref.</td><td class=\"val\">{{ref_doc.clients_reference or ''}}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"lbl\">Departure</td><td class=\"val\">{{ref_doc.expected_routing[-1].from or ''}}</td>\r\n      <td class=\"lbl\">Destination</td><td class=\"val\">{{ref_doc.expected_routing[-1].to or ''}}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"lbl\">Carrier</td><td class=\"val\">{{ref_doc.expected_routing[-1].vessel or ''}}&nbsp;{{ref_doc.expected_routing[-1].voyage or ''}}</td>\r\n      <td class=\"lbl\">Arrived on</td><td class=\"val\">{{ frappe.utils.getdate(ref_doc.expected_routing[-1].eta.split('Arrived On ')[-1]).strftime('%d-%m-%Y') if ref_doc.expected_routing and ref_doc.expected_routing[-1].eta else '' }}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"lbl\">M.B/L No.</td><td class=\"val\">{{ref_doc.bl_no or ''}}</td>\r\n      <td class=\"lbl\">M.B/L Date</td><td class=\"val\">{{ref_doc.bl_date or ''}}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"lbl\">No.-Packages</td><td class=\"val\">{{ref_doc.no_of_packs or ''}} CARTONS</td>\r\n      <td class=\"lbl\">Weight</td><td class=\"val\">{{ref_doc.gross_weight_kg or ''}} Kgs </td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"lbl\">Cargo</td><td class=\"val\">{{ref_doc.cargo_type or ''}}</td>\r\n      <td class=\"lbl\">Volume</td><td class=\"val\">{{ref_doc.volume_cbm or ''}} CBM</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"lbl\">Load Type</td><td class=\"val\">{{ref_doc.load_type or ''}}</td>\r\n      <td class=\"lbl\"></td><td class=\"val\"></td>\r\n    </tr>\r\n  </table>\r\n  <div class=\"trn\">TRN -</div>\r\n\r\n  <!-- CHARGES -->\r\n  <table class=\"charges-table\">\r\n    <thead>\r\n      <tr>\r\n        <th>Description of Charges</th>\r\n        <th class=\"right\">Amount QAR</th>\r\n      </tr>\r\n    </thead>\r\n    <tbody>\r\n        {% for i in doc.items %}\r\n          <tr><td>{{i.item_name or ''}}</td><td class=\"right\">{{i.amount or ''}}</td></tr>\r\n        {% endfor %}\r\n    </tbody>\r\n  </table>\r\n\r\n  <!-- CONTAINER INFO -->\r\n  <div class=\"container-row\">Container Number(s) : {{ref_doc.table_tvep[0].container_no or ''}}&nbsp;{{ref_doc.table_tvep[0].c_type or ''}}</div>\r\n\r\n  <!-- BANK DETAILS -->\r\n  <div class=\"bank-section\">\r\n    <div class=\"bank-header\"><b>Commercial Bank of Qatar</b> &nbsp;| Swift Code | CBQAQAQA</div>\r\n    <div class=\"bank-row\">\r\n      <span>A/c No. (USD)</span>\r\n      <span class=\"val\">4530750008202 &nbsp;| IBAN | &nbsp;QA02CBQA000000004530750008202</span>\r\n    </div>\r\n    <div class=\"bank-row\">\r\n      <span>A/c No. (QAR)</span>\r\n      <span class=\"val\">QA94CBQA000000004530750008001 &nbsp;| IBAN | &nbsp;QA94 CBQA 0000 0000 4530 7500 0800 1</span>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- FOOTER -->\r\n  <div class=\"footer-block\">\r\n    <div class=\"total-row\">\r\n      <span>TOTAL {{doc.in_words or ''}}</span>\r\n      <span>{{doc.grand_total or ''}}</span>\r\n    </div>\r\n    \r\n    <div class=\"exch-rate\">Exchange Rate Applied. : {{doc.conversion_rate or ''}}</div>\r\n    \r\n    <div class=\"terms\">\r\n      <div>Any Discrepancy related to this invoice should be notified in writing within 7 Days from the date of receipt.</div>\r\n      <div>Failing which, the amount specified will be considered payable.</div>\r\n    </div>\r\n    \r\n    <div class=\"for-company\">for {{doc.company or ''}} &nbsp;&nbsp; E & O E</div>\r\n    \r\n    <div class=\"note\">\r\n      <div>This document can be re-produce in Arabic language, upon request. Further should you wish to set Arabic as your preferred language</div>\r\n      <div>for future standard notices, please contact our customer service on 44702211.</div>\r\n    </div>\r\n    \r\n    <div class=\"company-info\">\r\n      <div>C.R.No: 23924 | PAID UP CAPITAL: QAR 3,000,000.00 |Bankers: CBQ Bank, QAR. A/C No. 4530-750008-001,</div>\r\n      <div>US $ A/C No. 4530-750008-202 | P.O Box 12698, Doha-Qatar | Tel: (+974) 4470 2224| Fax: (+974) 4444 2385</div>\r\n      <div>E-mail: icss@qatar.net.qa | Web: www.icssq.com</div>\r\n    </div>\r\n    \r\n    <div class=\"generated\">Generated By {{doc.owner}} &nbsp;On {{doc.creation}}</div>\r\n  </div>\r\n\r\n</div>\r\n\r\n</body>\r\n</html>",
