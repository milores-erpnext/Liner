 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <title>Cargo Arrival Notice Arabic (Import)</title>\r\n    <style>\r\n        @page {\r\n            size: A4;\r\n            margin: 8mm;\r\n        }\r\n\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            font-size: 9.5px;\r\n            color: #000;\r\n            margin: 0;\r\n            padding: 0;\r\n            background-color: #fff;\r\n        }\r\n\r\n        .page {\r\n            width: 100%;\r\n            page-break-after: always;\r\n            box-sizing: border-box;\r\n            position: relative;\r\n            min-height: auto;\r\n            padding-bottom: 0;\r\n        }\r\n\r\n        .page:last-child {\r\n            page-break-after: avoid;\r\n        }\r\n\r\n        /* Header */\r\n        .header {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n            border-bottom: 2px solid #000;\r\n            padding-bottom: 4px;\r\n            margin-bottom: 6px;\r\n        }\r\n\r\n        .logo-section {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 10px;\r\n        }\r\n\r\n        .logo-box {\r\n            font-weight: bold;\r\n            font-size: 22px;\r\n            border: 2px solid #000;\r\n            padding: 2px 6px;\r\n            letter-spacing: 1px;\r\n        }\r\n\r\n        .company-title {\r\n            font-size: 9.5px;\r\n            font-weight: bold;\r\n            line-height: 1.2;\r\n        }\r\n\r\n        .arabic-title {\r\n            font-size: 10.5px;\r\n            font-weight: bold;\r\n            text-align: right;\r\n            direction: rtl;\r\n            line-height: 1.2;\r\n        }\r\n\r\n        /* Top Bar */\r\n        .date-line {\r\n            text-align: right;\r\n            font-weight: bold;\r\n            margin-bottom: 4px;\r\n            font-size: 10px;\r\n        }\r\n\r\n        /* Info Grid */\r\n        .info-grid {\r\n            display: table;\r\n            width: 100%;\r\n            margin-bottom: 6px;\r\n        }\r\n\r\n        .info-row {\r\n            display: table-row;\r\n        }\r\n\r\n        .info-col {\r\n            display: table-cell;\r\n            width: 50%;\r\n            vertical-align: top;\r\n        }\r\n\r\n        .info-box {\r\n            border: 1px solid #000;\r\n            padding: 5px;\r\n            min-height: 48px;\r\n        }\r\n\r\n        .info-box-title {\r\n            font-weight: bold;\r\n            margin-bottom: 3px;\r\n            font-size: 9.5px;\r\n        }\r\n\r\n        .notification-header {\r\n            text-align: center;\r\n            font-weight: bold;\r\n            font-size: 12px;\r\n            margin: 6px 0 4px 0;\r\n            text-decoration: underline;\r\n        }\r\n\r\n        .ref-line {\r\n            font-weight: bold;\r\n            font-size: 9.5px;\r\n            margin-bottom: 4px;\r\n        }\r\n\r\n        /* Bilingual Grid */\r\n        .bilingual-block {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            gap: 10px;\r\n            margin-bottom: 8px;\r\n            font-size: 9px;\r\n            line-height: 1.25;\r\n        }\r\n\r\n        .en-col {\r\n            width: 50%;\r\n            text-align: left;\r\n        }\r\n\r\n        .ar-col {\r\n            width: 50%;\r\n            text-align: right;\r\n            direction: rtl;\r\n        }\r\n\r\n        /* Section Title */\r\n        .section-heading {\r\n            font-weight: bold;\r\n            font-size: 10px;\r\n            text-decoration: underline;\r\n            margin: 6px 0 4px 0;\r\n            text-transform: uppercase;\r\n        }\r\n\r\n        /* Tables */\r\n        table.data-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            margin-bottom: 6px;\r\n        }\r\n\r\n        table.data-table th, \r\n        table.data-table td {\r\n            border: 1px solid #000;\r\n            padding: 3px 5px;\r\n            font-size: 9px;\r\n            vertical-align: top;\r\n        }\r\n\r\n        table.data-table th {\r\n            background-color: #f2f2f2;\r\n            font-weight: bold;\r\n            text-align: left;\r\n        }\r\n\r\n        .text-right {\r\n            text-align: right;\r\n        }\r\n\r\n        .text-center {\r\n            text-align: center;\r\n        }\r\n\r\n        .bold {\r\n            font-weight: bold;\r\n        }\r\n\r\n        .rtl {\r\n            direction: rtl;\r\n            text-align: right;\r\n        }\r\n\r\n        /* Terms & Notes */\r\n        .disclaimer-box {\r\n            font-size: 8.5px;\r\n            line-height: 1.2;\r\n            margin-top: 6px;\r\n        }\r\n\r\n        .signature-container {\r\n            margin-top: 15px;\r\n            display: flex;\r\n            justify-content: space-between;\r\n        }\r\n\r\n        .signature-block {\r\n            width: 280px;\r\n            font-size: 9.5px;\r\n        }\r\n\r\n        .signature-space {\r\n            height: 35px;\r\n        }\r\n\r\n        /* Footer */\r\n        .footer {\r\n            position: relative;\r\n            border-top: 1px solid #000;\r\n            padding-top: 3px;\r\n            margin-top: 15px;\r\n            font-size: 8px;\r\n            text-align: center;\r\n            line-height: 1.25;\r\n        }\r\n\r\n        .footer-ar {\r\n            direction: rtl;\r\n            font-size: 8px;\r\n            margin-top: 1px;\r\n        }\r\n\r\n        .footer-gen {\r\n            display: flex;\r\n            justify-content: flex-start;\r\n            font-size: 7.5px;\r\n            margin-top: 2px;\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n    <!-- PAGE 1 -->\r\n    <div class=\"page\">\r\n        <!-- Header -->\r\n        <div class=\"header\">\r\n            <div class=\"logo-section\">\r\n                <div class=\"company-title\">\r\n                    {{letter_head}}\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Date & Header Details -->\r\n        <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;\">\r\n            <div>\r\n                <strong>Job Ref.:</strong> {{ doc.name }}\r\n            </div>\r\n        \r\n            <div>\r\n                <strong>NOTIFICATION</strong>\r\n            </div>\r\n        \r\n            <div>\r\n                <strong>DATE:</strong> {{ frappe.utils.today() }}\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Consignee / Notify Party Grid -->\r\n        <div class=\"info-grid\">\r\n            <div class=\"info-row\">\r\n                <div class=\"info-col\" style=\"padding-right: 3px;\">\r\n                    <div class=\"info-box\">\r\n                        <div class=\"info-box-title\">Consignee / \u0627\u0644\u0645\u0633\u062a\u0648\u0631\u062f</div>\r\n                        {{frappe.db.get_value(\"Party Table\",{\"party\":\"Consignee\",\"parent\":doc.name},\"name1\")}}<br>\r\n                        {{frappe.db.get_value(\"Party Table\",{\"party\":\"Consignee\",\"parent\":doc.name},\"address\")}}\r\n                    </div>\r\n                </div>\r\n                <div class=\"info-col\" style=\"padding-left: 3px;\">\r\n                    <div class=\"info-box\">\r\n                        <div class=\"info-box-title\">Notify Party / \u0627\u0644\u0637\u0631\u0641 \u0627\u0644\u0645\u0628\u0644\u063a</div>\r\n                        {{frappe.db.get_value(\"Party Table\",{\"party\":\"Consignee\",\"parent\":doc.name},\"name1\")}}<br>\r\n                        {{frappe.db.get_value(\"Party Table\",{\"party\":\"Notify1\",\"parent\":doc.name},\"address\")}}\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div><b>Dear Sir/Madam,</b></div>\r\n        <!-- Side-by-side Arrival Text -->\r\n        <div class=\"bilingual-block\">\r\n            <div class=\"en-col\">\r\n                We wish to advice you that the cargo consigned to your good selves Vessel has <b>{{ doc.expected_routing[-1].eta }}</b> at Hamad port from Cochin Seaport. We shall be highly obliged if you would take necessary steps to present the duly endorsed ORIGINAL Bill of Lading and ensure collecting the Delivery Order / Release order against payment of all relevant charges and arrange clearance of your cargo at the earliest.<br>\r\n                In case if you wish to release the shipment against the bank guarantee, kindly notify our office immediately and arrange for shipper's release instruction through our Load Port Agents.\r\n            </div>\r\n            <div class=\"ar-col\">\r\n                \u0639\u0632\u064a\u0632\u064a \u0627\u0644\u0633\u064a\u062f / \u0627\u0644\u0633\u064a\u062f\u0629 \u0645\u0631\u062c\u0639 \u0631\u0642\u0645 \u0627\u0644\u0628\u0627\u062e\u0631\u0629 / \u0627\u0644\u0631\u062d\u0644\u0629<br>\r\n                \u0646\u0648\u062f \u0627\u0644\u0625\u0634\u0627\u0631\u0629 \u0627\u0644\u064a\u0643\u0645 \u0628\u0623\u0646 \u0627\u0644\u0634\u062d\u0646\u0629 \u0627\u0644\u0645\u0631\u0633\u0644\u0629 \u0644\u062d\u0636\u0631\u062a\u0643\u0645 \u0627\u0644\u0628\u0627\u062e\u0631\u0629 \u0642\u062f \u0648\u0635\u0644\u062a \u0628\u062a\u0627\u0631\u064a\u062e {{ doc.expected_routing[-1].eta }}\u0627\u0644\u0649 Hamad \u0645\u0646 \u0645\u064a\u0646\u0627\u0621 Cochin Seaport \u0648\u0633\u0646\u0643\u0648\u0646 \u0645\u0644\u0632\u0645\u064a\u0646 \u0644\u0644\u063a\u0627\u064a\u0629 \u0625\u0630\u0627 \u0627\u062a\u062e\u0630\u062a\u0645 \u0627\u0644\u062e\u0637\u0648\u0627\u062a \u0627\u0644\u0644\u0627\u0632\u0645\u0629 \u0644\u0639\u0631\u0636 \u0645\u0627 \u062a\u0645 \u0625\u0642\u0631\u0627\u0631\u0647 \u0639\u0644\u0649 \u0628\u0648\u0644\u064a\u0635\u0629 \u0627\u0644\u0634\u062d\u0646 \u0648\u0627\u0644\u062a\u0623\u0643\u062f \u0645\u0646 \u0625\u0633\u062a\u0644\u0627\u0645 \u0623\u0645\u0631 \u0627\u0644\u062a\u0633\u0644\u064a\u0645 / ORIGINAL \u0627\u0644\u0646\u062d\u0648 \u0627\u0644\u0648\u0627\u062c\u0628 \u0623\u0630\u0646 \u0627\u0644\u0625\u0641\u0631\u0627\u062c \u0645\u0642\u0627\u0628\u0644 \u062f\u0641\u0639 \u0643\u0644 \u0627\u0644\u0631\u0633\u0648\u0645 \u0627\u0644\u0645\u0633\u062a\u062d\u0642\u0629 \u0648\u0628\u062f\u0621 \u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u062a\u062e\u0644\u064a\u0635 \u0627\u0644\u062c\u0645\u0631\u0643\u064a \u0639\u0644\u0649 \u0627\u0644\u0634\u062d\u0646\u0629 \u0641\u064a \u0623\u0642\u0631\u0628 \u0648\u0642\u062a.<br>\r\n                \u0641\u064a \u062d\u0627\u0644 \u0627\u0644\u0631\u063a\u0628\u0629 \u0628\u0644\u0625\u0641\u0631\u0627\u062c \u0639\u0646 \u0627\u0644\u0634\u062d\u0646\u0629 \u0645\u0642\u0627\u0628\u0644 \u0636\u0645\u0627\u0646 \u0628\u0646\u0643\u064a \u0627\u0644\u0631\u062c\u0627\u0621 \u0625\u0628\u0644\u0627\u063a \u0645\u0643\u062a\u0628\u0646\u0627 \u0641\u064a \u0627\u0644\u062d\u0627\u0644 \u0648\u062a\u0623\u0645\u064a\u0646 \u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0627\u0644\u0625\u0641\u0631\u0627\u062c \u0639\u0646 \u0627\u0644\u0634\u062d\u0646\u0629 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u0648\u0643\u064a\u0644 \u0641\u064a \u0645\u064a\u0646\u0627\u0621 \u0627\u0644\u062a\u062d\u0645\u064a\u0644.\r\n            </div>\r\n        </div>\r\n\r\n        <!-- DETAILS OF CARGO -->\r\n        <div class=\"section-heading\">DETAILS OF CARGO / \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0634\u062d\u0646\u0629</div>\r\n        <table class=\"data-table\">\r\n            <tr>\r\n                <td width=\"20%\"><b>Shipper (s) / \u0627\u0644\u0645\u0635\u062f\u0631</b></td>\r\n                <td width=\"40%\">{{frappe.db.get_value(\"Party Table\",{\"party\":\"Shipper\",\"parent\":doc.name},\"name1\") }}</td>\r\n                <td width=\"20%\"><b>Load Type / \u0646\u0648\u0639 \u0627\u0644\u062d\u0645\u0648\u0644\u0629</b></td>\r\n                <td width=\"20%\">{{ doc.load_type or \"\" }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td><b>\u0631\u0642\u0645 \u0628\u0648\u0644\u064a\u0635\u0629 \u0627\u0644\u0634\u062d\u0646 / HBL No</b></td>\r\n                <td>{{ doc.bl_no or \"\" }}</td>\r\n                <td><b>\u0646\u0648\u0639 \u0628\u0648\u0644\u064a\u0635\u0629 \u0627\u0644\u0634\u062d\u0646 / BL Type</b></td>\r\n                <td>{{ bl_type or \"\" }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td><b>No. OF Packages / \u0639\u062f\u062f \u0627\u0644\u0637\u0631\u0648\u062f</b></td>\r\n                <td>{{ doc.no_of_packs }}</td>\r\n                <td><b>Weight / \u0627\u0644\u0648\u0632\u0646</b></td>\r\n                <td>{{ doc.gross_weight_kg }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td><b>Terms of Delivery / \u0634\u0631\u0637 \u0627\u0644\u062a\u0633\u0644\u064a\u0645</b></td>\r\n                <td>{{ doc.move_type }}</td>\r\n                <td><b>Volume / \u0627\u0644\u062d\u062c\u0645</b></td>\r\n                <td>{{ doc.volume_cbm}}</td>\r\n            </tr>\r\n            <tr>\r\n                <td><b>Cargo.. \u0627\u0644\u0634\u062d\u0646\u0629</b></td>\r\n                <td colspan=\"3\">\r\n                    {{ doc.desc_of_goods or ''}}\r\n                </td>\r\n            </tr>\r\n        </table>\r\n\r\n        <!-- Charges Table -->\r\n        <table class=\"data-table\">\r\n            <thead>\r\n                <tr>\r\n                    <th>Description</th>\r\n                    <th width=\"20%\" class=\"text-right\">Amount (QAR)</th>\r\n                    <th width=\"20%\">\u0627\u0644\u0648\u0635\u0641</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {% for item in doc.contract_agreement %}\r\n                <tr>\r\n                    <td>{{ item.item_name }}</td>\r\n                    <td class=\"text-right\">{{ item.line_total_amount }}</td>\r\n                    <td class=\"text-right\">{{ item.item_name_arabic or \"\" }}</td>\r\n                </tr>\r\n                {% endfor %}\r\n                <tr>\r\n                    <td class=\"bold\">E&O.E &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; TOTAL</td>\r\n                    <td class=\"text-right bold\">{{ doc.grand_total+doc.total_liner }}</td>\r\n                    <td class=\"text-right \">\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</td>\r\n                </tr>\r\n            </tbody>\r\n        </table>\r\n\r\n        <div style=\"margin-bottom: 6px;\">\r\n            <b>Container No (s) / \u0631\u0642\u0645 \u0627\u0644\u062d\u0627\u0648\u064a\u0629 :</b >{{ doc.table_tvep | map(attribute=\"container_no\") | join(\", \") }}\r\n        </div>\r\n\r\n        <!-- DG Regulation Notice -->\r\n        <div class=\"disclaimer-box\">\r\n            As per the DG acceptance regulation set by Hamad Port Authority, If the cargo imported falls under IMDG/Chemical category irrespective of their class or type of cargo, requires permission from terminal to discharge the DG container. The port approval is not obtained from Port Authority, no pre arrangement completed prior to the vessel Arrival, the Agents shall not be responsible if the cargo is not discharged from the vessel by Hamad Port Authority.\r\n            <div class=\"rtl\" style=\"margin-top: 3px;\">\r\n                \u0648\u0641\u0642\u0627 \u0644\u0644\u0627\u0626\u062d\u0629 \u0642\u0628\u0648\u0644 \u0627\u0644\u0645\u0648\u0627\u062f \u0627\u0644\u062e\u0637\u0631\u0629 \u0627\u0644\u062a\u064a \u0648\u0636\u0639\u062a\u0647\u0627 \u0647\u064a\u0626\u0629 \u0645\u064a\u0646\u0627\u0621 \u062d\u0645\u062f \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0634\u062d\u0646\u0629 \u0627\u0644\u0645\u0633\u062a\u0648\u0631\u062f\u0629 \u062a\u0646\u062f\u0631\u062c \u0636\u0645\u0646 \u0641\u0626\u0629 \u0627\u0644\u0645\u0648\u0627\u062f \u0627\u0644\u0643\u064a\u0645\u064a\u0627\u0626\u064a\u0629 \u0628\u0635\u0631\u0641 \u0627\u0644\u0646\u0638\u0631 \u0639\u0646 \u0641\u0626\u062a\u0647\u0627 \u0623\u0648 \u0646\u0648\u0639 \u0634\u062d\u0646\u062a\u0647\u0627. \u0648\u064a\u062a\u0637\u0644\u0628 \u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0625\u0630\u0646 \u0645\u0646 \u0627\u0644\u0645\u062d\u0637\u0629 \u0644\u062a\u0641\u0631\u064a\u063a \u062d\u0627\u0648\u064a\u0629 \u0627\u0644\u0645\u0648\u0627\u062f \u0627\u0644\u062e\u0637\u0631\u0629 \u0648\u0625\u0630\u0627 \u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0645\u064a\u0646\u0627\u0621 \u0645\u0646 \u0647\u064a\u0626\u0629 \u0627\u0644\u0645\u0648\u0627\u0646\u0626 \u060c \u0648\u0644\u0645 \u064a\u062a\u0645 \u0625\u062c\u0631\u0627\u0621 \u0623\u064a \u062a\u0631\u062a\u064a\u0628 \u0645\u0633\u0628\u0642 \u0642\u0628\u0644 \u0648\u0635\u0648\u0644 \u0627\u0644\u0633\u0641\u064a\u0646\u0629 \u0644\u0627 \u064a\u0643\u0648\u0646 \u0627\u0644\u0648\u0643\u0644\u0627\u0621 \u0645\u0633\u0624\u0648\u0644\u064a\u0646 \u0625\u0630\u0627 \u0644\u0645 \u062a\u0641\u0631\u063a \u0647\u064a\u0626\u0629 \u0645\u064a\u0646\u0627\u0621 \u062d\u0645\u062f \u0627\u0644\u0634\u062d\u0646\u0629 \u0645\u0646 \u0627\u0644\u0633\u0641\u064a\u0646\u0629.\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"disclaimer-box\" style=\"margin-top: 5px;\">\r\n            Kindly note that we perform Custom clearance also as part of our service. If you require us to do customs clearance on your behalf, kindly submit all original documents at the earliest.\r\n            <div class=\"rtl\" style=\"margin-top: 2px;\">\r\n                \u0643\u0645\u0627 \u0646\u0631\u062c\u0648\u0627 \u0627\u0644\u0639\u0644\u0645 \u0628\u0627\u0646\u0646\u0627 \u0646\u0642\u0648\u0645 \u0628\u0627\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u062a\u062e\u0644\u064a\u0635 \u0627\u0644\u062c\u0645\u0631\u0643\u064a \u060c \u0648\u0641\u064a \u062d\u0627\u0644 \u0631\u063a\u0628\u062a\u0643\u0645 \u0642\u064a\u0627\u0645\u0646\u0627 \u0628\u0627\u0644\u062a\u062e\u0644\u064a\u0635 \u0627\u0644\u062c\u0645\u0631\u0643\u064a \u0646\u064a\u0627\u0628\u0629 \u0639\u0646 \u0634\u0631\u0643\u062a\u0643\u0645 \u060c \u0646\u0631\u062c\u0648\u0627 \u0645\u0646\u0643\u0645 \u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0627\u0644\u0627\u0635\u0644\u064a\u0629 \u0641\u064a \u0627\u0633\u0631\u0639 \u0648\u0642\u062a.\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"disclaimer-box\" style=\"margin-top: 5px;\">\r\n            We request that the empty containers be returned to the line's stack in Clean & Sound condition with IMCO labels, if any, removed. Should there be any damage (internal/external) noticed, you are requested to forward us the photographs of the damaged part of the container including the container number portion. if damage is found to be due to cargo nature / shippers fault/consignee's fault then the repair cost need to be settled with us prior acceptance of MTY.\r\n        </div>\r\n    </div>\r\n\r\n\r\n    <!-- PAGE 2 -->\r\n    <div class=\"page\">\r\n        <!-- Bilingual Instructions -->\r\n        <div class=\"disclaimer-box\" style=\"margin-top: 10px;\">\r\n            <div class=\"rtl\" style=\"margin-bottom: 8px;\">\r\n                \u064a\u062c\u0628 \u0627\u0639\u0627\u062f\u0629 \u0627\u0644\u062d\u0627\u0648\u064a\u0629 \u0627\u0644\u0641\u0627\u0631\u063a\u0629 \u0627\u0644\u0649 \u0645\u062e\u0632\u0646 \u0627\u0644\u062d\u0627\u0648\u064a\u0627\u062a \u0627\u0644\u062e\u0627\u0635 \u0628\u0627\u0644\u062e\u0637 \u0627\u0644\u0645\u0644\u0627\u062d\u064a \u0628\u062d\u0627\u0644\u0629 \u062c\u064a\u062f\u0629 \u0648\u0646\u0638\u064a\u0641\u0629 \u0645\u0639 \u0627\u0644\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u0645\u062b\u0628\u062a\u0629 \u0628\u0627\u0644\u062d\u0627\u0648\u064a\u0629 \u0627\u0630\u0627 \u0643\u0627\u0646\u062a \u0645\u0648\u062c\u0648\u062f \u0648\u062e\u0627\u0644\u064a\u0629 \u0645\u0646 \u0627\u0644\u0627\u0636\u0631\u0627\u0631\u0627 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629 \u0623\u0648 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u060c \u0643\u0645\u0627 \u0646\u0631\u062c\u0648\u0627 \u062a\u0635\u0648\u064a\u0631 \u0627\u0644\u062c\u0632\u0621 \u0627\u0644\u0645\u062a\u0636\u0631\u0631 \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0631\u0642\u0627\u0645 \u0627\u0644\u062d\u0627\u0648\u064a\u0629 \u060c \u0648\u0627\u0630\u0627 \u0648\u062c\u062f\u062a \u0627\u064a\u0629 \u0627\u0636\u0631\u0627 \u0641\u0627\u0626\u0646\u0647\u0627 \u0645\u0646 \u0645\u0633\u0624\u0648\u0644\u064a\u0629 ( \u062e\u0637\u0623 \u0627\u0644\u0634\u0627\u062d\u0646\u064a\u0646 \u060c \u062e\u0637\u0623 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 ) \u0648\u0639\u0644\u064a\u0647 \u064a\u062c\u064a\u0628 \u062a\u0633\u062f\u064a\u062f \u0631\u0633\u0648\u0645 \u0627\u0644\u0635\u064a\u0627\u0646\u0629 \u0642\u0628\u0644 \u0627\u0633\u062a\u0644\u0627\u0645 \u0627\u0644\u062d\u0627\u0648\u064a\u0629 \u0627\u0644\u0641\u0627\u0631\u063a\u0629.\r\n            </div>\r\n\r\n            <div class=\"rtl\" style=\"margin-bottom: 4px;\">\r\n                \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0627\u062a \u064a\u062c\u0628 \u0627\u0646 \u062a\u0643\u0648\u0646 \u0628\u0634\u064a\u0643 \u0628\u0627\u0633\u0645 (International Commercial and Shipping Services Company W.L.L) \u0628\u0646\u0638\u0627\u0645 \u0627\u0644\u0627\u064a\u062f\u0627\u0639 \u0641\u064a \u0627\u0644\u062d\u0633\u0627\u0628 \u0648\u0644\u0627 \u062a\u0642\u0628\u0644 \u0627\u0644\u0634\u064a\u0643\u0627\u062a \u0627\u0644\u0634\u062e\u0635\u064a\u0629.\r\n            </div>\r\n            <p style=\"margin: 2px 0 8px 0;\">\r\n                All payments must be made by \"ACCOUNT PAYEE\" Cheques in the name of <b>International Commercial and Shipping Services Company W.L.L</b>. Personnel cheques are not accepted.\r\n            </p>\r\n\r\n            <p style=\"margin: 2px 0 4px 0;\">\r\n                As per company policy, as a guarantee of the safe return of the empty container, you are requested to deposit a guarantee cheque along with a Letter of Indemnity in the prescribed format (Stamped & signed by Authorized Signatory) while collecting the Delivery Order.\r\n            </p>\r\n            <div class=\"rtl\" style=\"margin-bottom: 12px;\">\r\n                \u062d\u0633\u0628 \u0646\u0638\u0627\u0645 \u0627\u0644\u0634\u0631\u0643\u0629 \u0648\u0644\u0636\u0645\u0627\u0646 \u0627\u0639\u0627\u062f\u0629 \u0627\u0644\u062d\u0627\u0648\u064a\u0629 \u0628\u0627\u0645\u0627\u0646 \u060c \u064a\u062c\u0628 \u0627\u0628\u062f\u0627\u0639 \u0634\u064a\u0643 \u0636\u0645\u0627\u0646 \u0645\u0639 \u062e\u0637\u0627\u0628 \u0627\u0644\u062a\u0639\u0648\u064a\u0636 \u062d\u0633\u0628 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0645\u0639\u062a\u0645\u062f \u0648\u064a\u0643\u0648\u0646 \u0645\u062e\u062a\u0648\u0645 \u0648\u0645\u0648\u0642\u0639 \u0645\u0646 \u0627\u0644\u0645\u062e\u0648\u0644 \u0628\u0627\u0644\u062a\u0648\u0642\u064a\u0639\u060c \u0648\u0630\u0644\u0643 \u0639\u0646\u062f \u0627\u0633\u062a\u0644\u0627\u0645 \u0627\u0630\u0646 \u0627\u0644\u0627\u0641\u0631\u0627\u062c.\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Signature Block -->\r\n        <div class=\"signature-container\">\r\n            <div></div>\r\n            <div class=\"signature-block\">\r\n                For <b>International Commercial and Shipping Services Company W.L.L</b>\r\n                <div class=\"signature-space\"></div>\r\n                <b>{{ doc.owner }}</b>\r\n            </div>\r\n        </div>\r\n\r\n        <br>\r\n\r\n        <!-- Terms and Conditions Notes -->\r\n        <div class=\"disclaimer-box\" style=\"border-top: 1px dashed #000; padding-top: 8px; margin-top: 15px;\">\r\n            <p style=\"margin: 0 0 3px 0;\">\r\n                <b>Note - 1</b> - Arrival notice is sent as an act of courtesy, the shipping line / or agent will not be responsible for any consequences in the event of non-receipt of the arrival notices and no claims will be entertained.\r\n            </p>\r\n            <div class=\"rtl\" style=\"margin-bottom: 8px;\">\r\n                \u062a\u0631\u0633\u0644 \u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u0631\u0648\u0631 \u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062c\u0627\u0645\u0644\u0629 \u060c \u0648\u0644\u0646 \u064a\u0643\u0648\u0646 \u062e\u0637 \u0627\u0644\u0634\u062d\u0646 \u0648\u0643\u064a\u0644 \u0627\u0644\u0634\u062d\u0646 \u0645\u0633\u0624\u0648\u0644\u0627 \u0639\u0646 \u0623\u064a \u0639\u0648\u0627\u0642\u0628 \u0641\u064a \u062d\u0627\u0644\u0629 \u0639\u062f\u0645 \u062a\u0644\u0642\u064a \u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0627\u0644\u0648\u0635\u0648\u0644 \u060c \u0648\u0644\u0646 \u064a\u062a\u0645 \u0627\u0644\u0646\u0638\u0631 \u0641\u064a \u0623\u064a \u0645\u0637\u0627\u0644\u0628\u0627\u062a .<br>\r\n                \u0627\u0644\u0623\u062e\u0637\u0627\u0621 \u0648\u0627\u0644\u0625\u062e\u0641\u0627\u0642\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062b\u0646\u0627\u0629 - \u0642\u0627\u0628\u0644 \u0644\u0644\u062a\u063a\u064a\u064a\u0631 .\r\n            </div>\r\n\r\n            <p style=\"font-weight: bold; margin: 6px 0 3px 0;\">\r\n                LINE DEMURRAGE CHARGES SHALL BE APPLICABLE AFTER 7 DAYS FROM THE DATE OF ARRIVAL FOR STANDARD CONTAINERS (OR AS PER THE LINE'S TARIFF), 3 DAYS FOR TANK CONTAINERS AND SPECIAL CONTAINERS/EQUIPMENT (FLAT-RACK, OPENTOP, REEFER) AFTER ARRIVAL OF VESSEL.\r\n            </p>\r\n            <div class=\"rtl bold\" style=\"margin-bottom: 6px;\">\r\n                \u062a\u0628\u062f\u0623 \u0631\u0633\u0648\u0645 \u062a\u062e\u0632\u064a\u0646 \u0627\u0644\u0645\u0648\u0627\u0646\u0626 \u0628\u0639\u062f 7 \u064a\u0648\u0645\u0627 \u0645\u0646 \u062a\u0627\u0631\u064a\u062e \u062a\u0641\u0631\u064a\u063a \u0627\u0644\u0628\u0636\u0627\u0626\u0639 \u0648\u0627\u0644\u062d\u0627\u0648\u064a\u0627\u062a \u0627\u0644\u0639\u0627\u0645\u0629 \u0648 3 \u0623\u064a\u0627\u0645 \u0644\u0644\u0628\u0636\u0627\u0626\u0639 \u0648\u0627\u0644\u062d\u0627\u0648\u064a\u0627\u062a \u0630\u0627\u062a \u0627\u0644\u0645\u0648\u0627\u062f \u0627\u0644\u062e\u0637\u0631\u0629.<br>\r\n                \u0631\u0633\u0648\u0645 \u0627\u062d\u062a\u062c\u0627\u0632 \u0627\u0644\u062d\u0627\u0648\u064a\u0627\u062a \u0645\u0637\u0628\u0642\u0629 \u062d\u0633\u0628 \u0627\u0644\u062a\u0639\u0631\u0641\u0629 \u0627\u0644\u0635\u0627\u062f\u0631\u0629 \u0639\u0646 \u0627\u0644\u062e\u0637 \u0627\u0644\u0645\u0644\u0627\u062d\u064a.<br>\r\n                \u0627\u0644\u0633\u0644\u0639 \u0627\u0644\u0645\u062a\u0628\u0642\u064a\u0629 \u0641\u064a \u0627\u0644\u0645\u064a\u0646\u0627\u0621 \u0627\u0644\u063a\u064a\u0631 \u0645\u0637\u0627\u0644\u0628 \u0628\u0647\u0627 \u0644\u0641\u062a\u0631\u0629 \u062a\u0632\u064a\u062f \u0639\u0644\u0649 30 \u064a\u0648\u0645\u0627 \u060c \u0641\u0625\u0646 \u0647\u0630\u0647 \u0627\u0644\u0634\u062d\u0646\u0629 \u0623\u0648 \u0627\u0644\u062d\u0627\u0648\u064a\u0629 \u0633\u0648\u0641 \u064a\u062a\u0645 \u0646\u0642\u0644\u0647\u0627 \u0625\u0644\u0649 \u0633\u0627\u062d\u0629 \u0627\u0644\u0645\u0632\u0627\u062f \u0627\u0644\u0639\u0644\u0646\u064a \u0623\u0648 \u0627\u0644\u0625\u062a\u0644\u0627\u0641.\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Footer -->\r\n        <div class=\"footer\">\r\n            C.R.No: 23924 | PAID UP CAPITAL: QAR 3,000,000.