 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <title>Main Job Sheet Import</title>\r\n    <style>\r\n        @page {\r\n            size: A4 portrait;\r\n            margin: 10mm;\r\n        }\r\n\r\n        body {\r\n            font-family: Arial, Helvetica, sans-serif;\r\n            font-size: 10px;\r\n            color: #000;\r\n            margin: 0;\r\n            padding: 0;\r\n            background-color: #fff;\r\n        }\r\n\r\n        .page {\r\n            width: 100%;\r\n            page-break-after: always;\r\n            box-sizing: border-box;\r\n            position: relative;\r\n        }\r\n\r\n        .page:last-child {\r\n            page-break-after: avoid;\r\n        }\r\n\r\n        /* Company Header */\r\n        .company-header {\r\n            text-align: center;\r\n            font-size: 9px;\r\n            line-height: 1.35;\r\n            margin-bottom: 12px;\r\n            border-bottom: 1px solid #000;\r\n            padding-bottom: 6px;\r\n        }\r\n\r\n        .company-name {\r\n            font-size: 13px;\r\n            font-weight: bold;\r\n            margin-bottom: 3px;\r\n        }\r\n\r\n        .job-type-title {\r\n            text-align: center;\r\n            font-size: 12px;\r\n            font-weight: bold;\r\n            letter-spacing: 1px;\r\n            margin-bottom: 12px;\r\n            text-transform: uppercase;\r\n        }\r\n\r\n        /* Data Tables */\r\n        table.data-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            margin-bottom: 15px;\r\n        }\r\n\r\n        table.data-table th, \r\n        table.data-table td {\r\n            border: 1px solid #000;\r\n            padding: 5px 6px;\r\n            font-size: 9.5px;\r\n            vertical-align: middle;\r\n        }\r\n\r\n        table.data-table th {\r\n            background-color: #f2f2f2;\r\n            font-weight: bold;\r\n            text-align: left;\r\n            text-transform: uppercase;\r\n        }\r\n\r\n        /* Summary Banner */\r\n        .section-header-banner {\r\n            font-weight: bold;\r\n            font-size: 10.5px;\r\n            margin: 10px 0 5px 0;\r\n            background-color: #e6e6e6;\r\n            padding: 4px 6px;\r\n            border: 1px solid #000;\r\n        }\r\n\r\n        .text-center {\r\n            text-align: center;\r\n        }\r\n\r\n        .text-right {\r\n            text-align: right;\r\n        }\r\n\r\n        .bold {\r\n            font-weight: bold;\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n    <div class=\"page\">\r\n        <!-- Company Header -->\r\n        <div class=\"company-header\">\r\n            <div class=\"company-name\">International Commercial and Shipping Services Company W.L.L</div>\r\n            Building 131, Street 230, Zone 42. Al Hilal West, Doha, Qatar. Post Box 8681. CR # 23924.<br>\r\n            TEL:+974-44-11683 FAX:+974-43-52690 E-MAIL:icss@qatar.net.qa\r\n        </div>\r\n\r\n        <!-- Document Type Header -->\r\n        <div class=\"job-type-title\">IMPORTS</div>\r\n\r\n        <!-- Main Metadata Grid Table -->\r\n        <table class=\"data-table\">\r\n            <tr>\r\n                <td class=\"bold\" width=\"15%\">JOB NO.</td>\r\n                <td width=\"35%\">{{ doc.name or \"\" }}</td>\r\n                <td class=\"bold\" width=\"15%\">DATE</td>\r\n                <td width=\"35%\">{{ doc.creation or \"\" }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"bold\">LINE</td>\r\n                <td>{{ doc.line_name or \"\" }}</td>\r\n                <td class=\"bold\">ARRIVAL DATE</td>\r\n                <td>{{ doc.expected_routing[-1].eta }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"bold\">VESSEL</td>\r\n                <td>{{ doc.vessel or \"\" }}</td>\r\n                <td class=\"bold\">VOYAGE</td>\r\n                <td>{{ doc.voyage_no or \"\" }}</td>\r\n            </tr>\r\n        </table>\r\n\r\n        <!-- Consignee Table -->\r\n        <table class=\"data-table\">\r\n            <thead>\r\n                <tr>\r\n                    <th width=\"10%\">J.No</th>\r\n                    <th width=\"45%\">CONSIGNEE</th>\r\n                    <th width=\"45%\">NOTIFY1</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                <tr>\r\n                    <td class=\"text-center\">001</td>\r\n                    <td>{{frappe.db.get_value(\"Party Table\",{\"party\":\"Consignee\",\"parent\":doc.name},\"name1\")}}</td>\r\n                    <td>{{frappe.db.get_value(\"Party Table\",{\"party\":\"Notify1\",\"parent\":doc.name},\"name1\")}}</td>\r\n                </tr>\r\n            </tbody>\r\n        </table>\r\n\r\n        <!-- Summary Section Header -->\r\n        <div class=\"section-header-banner\">\r\n            Line: {{ line_code or \"TAL\" }} - Main Job No: {{ doc.name }}\r\n        </div>\r\n\r\n        <!-- Container Breakdown Summary Table -->\r\n        <table class=\"data-table\">\r\n            <thead>\r\n                <tr>\r\n                    <th width=\"40%\">No of BLs</th>\r\n                    <th width=\"20%\" class=\"text-center\"></th>\r\n                    <th width=\"20%\" class=\"text-center\">{{doc.table_cgpc[0].type or ''}}</th>\r\n                    <th width=\"10%\" class=\"text-center\">Total</th>\r\n                    <th width=\"10%\" class=\"text-center\">TEU</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                <tr>\r\n                    <td class=\"text-center\">1</td>\r\n                    <td class=\"text-center\"></td>\r\n                    <td class=\"text-center\">{{doc.table_cgpc[0].nos or ''}}</td>\r\n                    <td class=\"text-center\">{{doc.table_cgpc[0].nos or ''}}</td>\r\n                    <td class=\"text-center\">{{doc.table_cgpc[0].nos or ''}}</td>\r\n                </tr>\r\n            </tbody>\r\n        </table>\r\n\r\n        <!-- Port Summary Table -->\r\n        <table class=\"data-table\">\r\n            <thead>\r\n                <tr>\r\n                    <th width=\"60%\">Port Of Loading</th>\r\n                    <th width=\"15%\" class=\"text-center\">{{doc.table_cgpc[0].type or ''}}</th>\r\n                    <th width=\"12.5%\" class=\"text-center\">Total</th>\r\n                    <th width=\"12.5%\" class=\"text-center\">TUE</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                <tr>\r\n                    <td>{{frappe.db.get_value('Routing Table',{'hub':'Port of Loading','parent':doc.name},'hub_name') or ''}}</td>\r\n                    <td class=\"text-center\">{{doc.table_cgpc[0].nos or ''}}</td>\r\n                    <td class=\"text-center\">{{doc.table_cgpc[0].nos or ''}}</td>\r\n                    <td class=\"text-center\">{{doc.table_cgpc[0].nos or ''}}</td>\r\n                </tr>\r\n            \r\n                <tr class=\"bold\" style=\"background-color: #fafafa;\">\r\n                    <td>Total</td>\r\n                    <td class=\"text-center\">{{doc.table_cgpc[0].nos or ''}}</td>\r\n                    <td class=\"text-center\">{{doc.table_cgpc[0].nos or ''}}</td>\r\n                    <td class=\"text-center\">{{doc.table_cgpc[0].nos or ''}}</td>\r\n                </tr>\r\n            </tbody>\r\n        </table>\r\n\r\n    </div>\r\n\r\n</body>\r\n</html>",
